---
// src/pages/404.astro
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main class="section">
    <div class="text-center max-w-2xl mx-auto">
      {/* 404 Number - Using your text-gradient utility */}
      <div class="mb-8">
        <h1 class="text-9xl md:text-[12rem] font-bold text-gradient">404</h1>
      </div>

      {/* Message - Using your section classes */}
      <div class="section-header">
        <h2 class="section-title text-foreground">Page Not Found</h2>
        <p class="section-subtitle">
          Looks like you've ventured into uncharted territory. Let's get you
          back to safety.
        </p>
      </div>

      {/* Action Buttons - Using your btn components */}
      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
        <a href="/" class="btn btn-primary btn-lg"> ← Return Home </a>
        <a href="/contact" class="btn btn-outline btn-lg"> Get Help </a>
      </div>

      {/* Decorative Elements using your design system colors */}
      <div class="mt-16 opacity-60">
        <div class="flex justify-center space-x-6 text-3xl">
          <span class="animate-bounce text-primary" style="animation-delay: 0s;"
            >⚡</span
          >
          <span
            class="animate-bounce text-secondary"
            style="animation-delay: 0.2s;">🎨</span
          >
          <span
            class="animate-bounce text-accent"
            style="animation-delay: 0.4s;">🚀</span
          >
        </div>
        <p class="text-sm text-muted mt-4">
          Even bests of us gets lost sometimes :)
        </p>
      </div>
    </div>
  </main>
</BaseLayout>
