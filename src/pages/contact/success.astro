---
// src/pages/contact/success.astro
import '../../styles/global.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section
    class="flex min-h-screen items-center justify-center bg-background py-12">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-2xl text-center">
        <!-- Success Icon -->
        <div class="mb-8 flex justify-center">
          <div
            class="bg-success/20 flex h-24 w-24 items-center justify-center rounded-full">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-success">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
        </div>

        <!-- Success Message -->
        <h1 class="mb-6 text-4xl font-bold text-foreground md:text-5xl">
          Thank You!
        </h1>

        <p class="mb-8 text-xl leading-relaxed text-muted">
          Your message has been successfully sent. Our team will get back to you within 24 hours.
        </p>

        <!-- Additional Info -->
        <div
          class="mb-8 rounded-lg border border-border bg-background-muted p-6">
          <h2 class="mb-4 text-lg font-semibold text-foreground">
            What happens next?
          </h2>
          <ul class="space-y-3 text-left text-muted">
            <li class="flex items-start">
              <span class="mr-3 text-success">✓</span>
              <span>We'll review your message and requirements</span>
            </li>
            <li class="flex items-start">
              <span class="mr-3 text-success">✓</span>
              <span>Our team will contact you via email</span>
            </li>
            <li class="flex items-start">
              <span class="mr-3 text-success">✓</span>
              <span>We'll schedule a consultation if needed</span>
            </li>
            <li class="flex items-start">
              <span class="mr-3 text-success">✓</span>
              <span>You'll receive a detailed response with next steps</span>
            </li>
          </ul>
        </div>

        <!-- Contact Info -->
        <div class="mb-8">
          <p class="mb-4 text-muted">
            In the meantime, feel free to reach out directly:
          </p>
          <div class="flex flex-col justify-center gap-4 sm:flex-row">
            <a
              href="mailto:info.premiumdesigncompany@gmail.com"
              class="inline-flex items-center justify-center rounded-lg border border-border bg-background px-6 py-3 text-foreground transition-colors hover:bg-background-muted">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mr-2">
                <path
                  d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                ></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              Email Us
            </a>
            <a
              href="tel:+33759440610"
              class="inline-flex items-center justify-center rounded-lg border border-border bg-background px-6 py-3 text-foreground transition-colors hover:bg-background-muted">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mr-2">
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                ></path>
              </svg>
              Call Us
            </a>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          <a href="/" class="btn btn-primary px-8 py-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mr-2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            Back to Homepage
          </a>
          <a href="/contact" class="btn btn-outline px-8 py-3">
            Send Another Message
          </a>
        </div>

        <!-- Quick Response Note -->
        <div class="bg-success/10 border-success/20 mt-8 rounded-lg border p-4">
          <p class="text-sm text-success">
            💡 <strong>Quick Response Guarantee:</strong> We typically respond to
            all inquiries within 2-4 business hours during our working days.
          </p>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Smooth entrance animation */
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-fade-in-up {
      animation: fadeInUp 0.6s ease-out;
    }
  </style>

  <script type="text/javascript">
    // Add entrance animation when page loads
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelector('section').classList.add('animate-fade-in-up');
    });
  </script>
</BaseLayout>
