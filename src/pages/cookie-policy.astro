---
// src/pages/cookie-policy.astro
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="section">
    <div class="container-custom">
      <!-- Header -->
      <div class="section-header text-left">
        <h1 class="section-title">Cookie Policy</h1>
        <p class="section-subtitle text-left ml-0 max-w-none">
          Last updated: November 17, 2025
        </p>
      </div>

      <div class="mx-auto max-w-4xl space-y-8">
        <!-- Introduction -->
        <div class="card">
          <h2 class="mb-4 text-2xl font-bold">1. What Are Cookies</h2>
          <p class="leading-relaxed text-foreground-muted">
            Cookies are small text files that are placed on your device when you
            visit our website. They help us provide you with a better experience
            by remembering your preferences and understanding how you use our
            site.
          </p>
        </div>

        <!-- Types of Cookies -->
        <div class="card">
          <h2 class="mb-4 text-2xl font-bold">2. Types of Cookies We Use</h2>
          <div class="space-y-6">
            <div>
              <h3 class="mb-2 text-lg font-semibold">Essential Cookies</h3>
              <p class="text-foreground-muted">
                These cookies are necessary for the website to function
                properly. They enable basic functions like page navigation and
                access to secure areas.
              </p>
            </div>
            <div>
              <h3 class="mb-2 text-lg font-semibold">Analytics Cookies</h3>
              <p class="text-foreground-muted">
                These cookies help us understand how visitors interact with our
                website by collecting and reporting information anonymously.
              </p>
            </div>
            <div>
              <h3 class="mb-2 text-lg font-semibold">Preference Cookies</h3>
              <p class="text-foreground-muted">
                These cookies enable the website to remember information that
                changes the way the site behaves or looks, like your preferred
                language.
              </p>
            </div>
            <div>
              <h3 class="mb-2 text-lg font-semibold">Marketing Cookies</h3>
              <p class="text-foreground-muted">
                These cookies are used to track visitors across websites to
                display relevant advertisements.
              </p>
            </div>
          </div>
        </div>

        <!-- Specific Cookies -->
        <div class="card">
          <h2 class="mb-4 text-2xl font-bold">3. Cookies We Use</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-border">
                  <th class="px-4 py-2 text-left font-semibold">Cookie</th>
                  <th class="px-4 py-2 text-left font-semibold">Type</th>
                  <th class="px-4 py-2 text-left font-semibold">Purpose</th>
                  <th class="px-4 py-2 text-left font-semibold">Duration</th>
                </tr>
              </thead>
              <tbody class="text-foreground-muted">
                <tr class="border-b border-border-muted">
                  <td class="px-4 py-2">session_id</td>
                  <td class="px-4 py-2">Essential</td>
                  <td class="px-4 py-2">Maintain user session</td>
                  <td class="px-4 py-2">Session</td>
                </tr>
                <tr class="border-b border-border-muted">
                  <td class="px-4 py-2">preferences</td>
                  <td class="px-4 py-2">Preference</td>
                  <td class="px-4 py-2">Store user preferences</td>
                  <td class="px-4 py-2">1 year</td>
                </tr>
                <tr class="border-b border-border-muted">
                  <td class="px-4 py-2">_ga</td>
                  <td class="px-4 py-2">Analytics</td>
                  <td class="px-4 py-2">Google Analytics</td>
                  <td class="px-4 py-2">2 years</td>
                </tr>
                <tr>
                  <td class="px-4 py-2">_gid</td>
                  <td class="px-4 py-2">Analytics</td>
                  <td class="px-4 py-2">Google Analytics</td>
                  <td class="px-4 py-2">24 hours</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Managing Cookies -->
        <div class="card">
          <h2 class="mb-4 text-2xl font-bold">4. Managing Cookies</h2>
          <div class="space-y-4 text-foreground-muted">
            <p>
              You can control and/or delete cookies as you wish. You can delete
              all cookies that are already on your computer and you can set most
              browsers to prevent them from being placed.
            </p>
            <p>
              <strong>Browser Settings:</strong> Most web browsers allow you to control
              cookies through their settings preferences. However, limiting cookies
              may affect website functionality.
            </p>
            <p>
              <strong>Opt-out Tools:</strong> You can opt out of analytics cookies
              using browser add-ons or privacy tools.
            </p>
          </div>
        </div>

        <!-- Third-party Cookies -->
        <div class="card">
          <h2 class="mb-4 text-2xl font-bold">5. Third-party Cookies</h2>
          <p class="leading-relaxed text-foreground-muted">
            Some cookies are placed by third-party services that appear on our
            pages. We have no control over these third-party cookies and
            recommend you check their respective privacy policies for more
            information.
          </p>
        </div>

        <!-- Updates -->
        <div class="card">
          <h2 class="mb-4 text-2xl font-bold">6. Updates to This Policy</h2>
          <p class="leading-relaxed text-foreground-muted">
            We may update this Cookie Policy from time to time. We will notify
            you of any changes by posting the new policy on this page and
            updating the "Last updated" date.
          </p>
        </div>

        <!-- Contact -->
        <div class="card">
          <h2 class="mb-4 text-2xl font-bold">7. Contact Us</h2>
          <p class="leading-relaxed text-foreground-muted">
            If you have any questions about our use of cookies, please contact us:
          </p>
          <div class="mt-4 space-y-2">
            <p class="text-foreground">
              <strong>Email:</strong>
              <a href="mailto:info.premiumdesigncompany@gmail.com" class="text-primary hover:text-primary-hover hover:underline">
                info.premiumdesigncompany@gmail.com
              </a>
            </p>
            <p class="text-foreground">
              <strong>Phone:</strong>
              <a href="tel:+33759440610" class="text-primary hover:text-primary-hover hover:underline">
                +33 75 944 06 10
              </a>
            </p>
            <p class="text-foreground">
              <strong>Address:</strong> Gothenburg, Sweden
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
