---
// src/pages/blogs/[slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Formatting helper for publication date
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<BaseLayout
  title={`${post.data.title} | Premium Design Company`}
  description={post.data.description}>
  <article class="section">
    <div class="container-custom max-w-3xl">
      <!-- Back Link -->
      <a
        href="/blogs"
        class="inline-flex items-center gap-1.5 text-sm font-semibold uppercase tracking-wider text-foreground-muted hover:text-[#ff6a00] transition-colors mb-8"
      >
        ← Back to Articles
      </a>

      <!-- Header -->
      <header class="mb-12 pb-8 border-b border-border-muted">
        <div class="flex flex-wrap items-center gap-3 text-sm text-foreground-muted mb-4">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          <span class="inline-block h-1 w-1 rounded-full bg-border"></span>
          <span>By {post.data.author}</span>
          {post.data.readTime && (
            <>
              <span class="inline-block h-1 w-1 rounded-full bg-border"></span>
              <span>{post.data.readTime}</span>
            </>
          )}
        </div>

        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-foreground mb-6 leading-tight">
          {post.data.title}
        </h1>

        <!-- Tags -->
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="rounded bg-background-muted px-2.5 py-1 text-xs font-medium text-foreground-muted">
              {tag}
            </span>
          ))}
        </div>
      </header>

      <!-- Rendered Markdown Body -->
      <div class="blog-content">
        <Content />
      </div>

      <!-- Call to Action Footer -->
      <footer class="mt-16 pt-12 border-t border-border-muted text-center card bg-background p-8 md:p-12 rounded">
        <h3 class="text-2xl font-bold mb-4 text-foreground">
          Need premium design or frontend implementation?
        </h3>
        <p class="text-foreground-muted max-w-md mx-auto mb-8 leading-relaxed">
          We help tech startups and SaaS companies build standard-setting products, design systems, and lightning-fast web apps.
        </p>
        <div class="flex justify-center">
          <Button href="/contact" variant="primary">Get in Touch</Button>
        </div>
      </footer>
    </div>
  </article>
</BaseLayout>

<style is:global>
  /* Blog article premium typography styling */
  .blog-content {
    font-size: 1.125rem; /* 18px */
    color: var(--color-foreground);
    line-height: 1.8;
  }
  .blog-content p {
    margin-bottom: 1.75rem;
    line-height: 1.8;
  }
  .blog-content h2 {
    font-size: 1.875rem; /* 30px */
    font-weight: 700;
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    color: var(--color-foreground);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .blog-content h3 {
    font-size: 1.4rem; /* 22px */
    font-weight: 700;
    margin-top: 2.25rem;
    margin-bottom: 1rem;
    color: var(--color-foreground);
    line-height: 1.4;
  }
  .blog-content ul {
    list-style-type: disc;
    margin-bottom: 1.75rem;
    padding-left: 1.5rem;
  }
  .blog-content ol {
    list-style-type: decimal;
    margin-bottom: 1.75rem;
    padding-left: 1.5rem;
  }
  .blog-content li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }
  .blog-content blockquote {
    border-left: 4px solid #ff6a00;
    padding-left: 1.5rem;
    font-style: italic;
    color: var(--color-foreground-muted);
    margin: 2.25rem 0;
  }
  .blog-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 2.5rem 0;
    font-size: 1rem;
  }
  .blog-content th {
    background-color: var(--color-background-muted);
    border-bottom: 2px solid var(--color-border-muted);
    padding: 0.85rem 1.1rem;
    text-align: left;
    font-weight: 600;
    color: var(--color-foreground);
  }
  .blog-content td {
    border-bottom: 1px solid var(--color-border-muted);
    padding: 0.85rem 1.1rem;
    color: var(--color-foreground-muted);
  }
  .blog-content code {
    background-color: var(--color-background-muted);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: var(--color-foreground);
  }
  .blog-content pre {
    background-color: #121212 !important; /* Keep pre dark in both modes for premium contrast */
    color: #e5e5e5;
    padding: 1.5rem;
    border-radius: 6px;
    overflow-x: auto;
    margin: 2.5rem 0;
    font-size: 0.9rem;
    border: 1px solid #262626;
  }
  .blog-content pre code {
    background-color: transparent;
    padding: 0;
    border-radius: 0;
    color: inherit;
    font-size: inherit;
  }
  .blog-content strong {
    font-weight: 700;
    color: var(--color-foreground);
  }
  .blog-content hr {
    border: 0;
    border-top: 1px solid var(--color-border-muted);
    margin: 3rem 0;
  }
</style>
