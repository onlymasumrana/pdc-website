];
---

<section class="section">
  <div>
     <!-- Heading -->
    <div class="mb-3 md:mb-6 flex flex-col md:flex-row md:gap-10">
      <p class="text-sm font-medium uppercase tracking-wider "><span style="color: rgb(255, 106, 0); font-size: 20px;">✷</span>Testimonial</p>
        <h2 class="section-title">
          <span class="text-foreground">Trusted </span>
          <span class="text-muted">by happy people globally</span>
        </h2>
    </div>
    <!-- Testimonials Grid -->
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {testimonials.map((item) => (
        <div class="bg-background rounded-lg p-6 text-left">
          <p class="">"{item.text}"</p>
          <div class="flex items-center gap-3 mt-10">
            <img src={item.image} alt={item.name} class="w-10 h-10 rounded-full object-cover"/>
            <div>
              <h4 class="text-foreground font-semibold">{item.name}</h4>
              <p class="text-muted">{item.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
