<section class="section">
  <div class="">
    <!-- Heading -->
    <div class="mb-6 flex flex-col md:flex-row md:gap-10">
      <p class="text-sm font-medium uppercase tracking-wider col-span-1 ml-5">
        <span class="text-orange-500 text-4xl">✷</span> GET IN TOUCH
      </p>

      <div>
        <h2 class="section-title flex flex-wrap">
          <span class="text-foreground">Have any </span>
          <span class="text-muted">idea to build?</span>
        </h2>

        <!-- Toggle Buttons -->
        <div
          class="inline-flex rounded-full border bg-background p-1 shadow-sm w-fit mb-8"
        >
          <button
            data-type="quotes"
            class="px-4 py-2 text-sm font-medium rounded-full bg-[#0A1529] text-white"
          >
            Request a quotes
          </button>
          <button
            data-type="call"
            class="px-4 py-2 text-sm font-medium rounded-full text-gray-600 hover:text-gray-900"
          >
            Book a call
          </button>
        </div>
      </div>
    </div>

    <!-- Contact Form + Info -->
    <div class="w-full bg-background md:col-span-6 p-3">
      <div class="flex flex-col md:flex-row gap-8">
        <!-- Left Section (Contact Info - Desktop) -->
        <div class="hidden md:flex flex-col justify-between flex-1">
          <h2
            class="text-2xl md:text-3xl font-bold text-foreground leading-snug mb-6"
          >
            We love to hear from you!
          </h2>
          <div class="space-y-4">
            <!-- Email -->
            <div
              class="flex justify-between w-2/3 shadow p-4 rounded bg-bg-background"
            >
              <div>
                <h4 class="text-muted">Email Us</h4>
                <p class="text-foreground">support@premiumdesign.com</p>
              </div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                fill="none"
                viewBox="0 0 24 24"
                class="text-muted"
              >
                <path
                  d="M7 17L17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
            <!-- Phone -->
            <div
              class="flex justify-between w-2/3 shadow p-4 rounded bg-bg-background"
            >
              <div>
                <h4 class="text-muted">Call Us</h4>
                <p class="text-foreground">+1234567890</p>
              </div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                fill="none"
                viewBox="0 0 24 24"
                class="text-muted"
              >
                <path
                  d="M7 17L17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
            <!-- Address -->
            <div
              class="flex justify-between w-2/3 shadow p-4 rounded bg-bg-background"
            >
              <div>
                <h4 class="text-muted">Address</h4>
                <p class="text-foreground">
                  123 Business Street, San Francisco, CA
                </p>
              </div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                fill="none"
                viewBox="0 0 24 24"
                class="text-muted"
              >
                <path
                  d="M7 17L17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- Right Section (Form) -->
        <div class="rounded-2xl p-6 bg-background-muted flex-1">
          <form class="space-y-6">
            <!-- Services -->
            <div>
              <label class="block text-sm font-semibold mb-2">Service</label>
              <div class="flex flex-wrap gap-2">
                <button
                  type="button"
                  class="px-3 py-1.5 text-sm rounded-md bg-background font-medium"
                  >AI Development</button
                >
                <button
                  type="button"
                  class="px-3 py-1.5 text-sm rounded-md bg-background font-medium border"
                  >UI/UX Design</button
                >
                <button
                  type="button"
                  class="px-3 py-1.5 text-sm rounded-md bg-background font-medium"
                  >Web Development</button
                >
                <button
                  type="button"
                  class="px-3 py-1.5 text-sm rounded-md bg-background font-medium"
                  >E-commerce Development</button
                >
                <button
                  type="button"
                  class="px-3 py-1.5 text-sm rounded-md bg-background font-medium"
                  >Branding</button
                >
                <button
                  type="button"
                  class="px-3 py-1.5 text-sm rounded-md bg-background font-medium"
                  >No-code (Webflow, Framer)</button
                >
              </div>
            </div>

            <!-- Budget -->
            <div>
              <label class="block text-sm font-semibold mb-2">Budget</label>
              <div class="flex flex-wrap gap-2">
                <button
                  type="button"
                  class="px-3 py-1.5 text-sm rounded-md bg-background font-medium"
                  >Less than $10k</button
                >
                <button
                  type="button"
                  class="px-3 py-1.5 text-sm rounded-md bg-background font-medium"
                  >$10k - $50k</button
                >
                <button
                  type="button"
                  class="px-3 py-1.5 text-sm rounded-md bg-background font-medium"
                  >More than $50k</button
                >
              </div>
            </div>

            <!-- Inputs -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <label class="block text-sm">
                Name
                <input
                  type="text"
                  required
                  placeholder="Enter your name"
                  class="w-full rounded-lg p-3 mt-1"
                />
              </label>
              <label class="block text-sm">
                Email
                <input
                  type="email"
                  required
                  placeholder="Enter your email"
                  class="w-full rounded-lg p-3 mt-1"
                />
              </label>
            </div>

            <!-- File Upload -->
            <div>
              <p class="text-sm font-medium">Attach a file</p>
              <div
                class="border-2 border-dashed rounded-lg p-4 text-center cursor-pointer bg-background mt-1"
              >
                <input type="file" class="hidden" id="file" />
                <label for="file" class="cursor-pointer text-muted">
                  Choose a file or drag and drop here
                </label>
              </div>
            </div>

            <!-- Message -->
            <textarea
              placeholder="Enter your message"
              class="w-full rounded-lg p-3 h-28 border"></textarea>

            <!-- Button -->
            <button
              type="submit"
              class="btn btn-md btn-primary inline-flex items-center"
            >
              Send inquiry
              <div
                class="bg-background rounded ml-2 p-1 flex items-center justify-center"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  fill="none"
                  viewBox="0 0 24 24"
                  class="text-foreground"
                >
                  <path
                    d="M7 17L17 7M9 7h8v8"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </div>
            </button>
          </form>
        </div>
      </div>

      <!-- Mobile Contact Info -->
      <div class="md:hidden flex flex-col justify-between flex-1 mt-8">
        <h2
          class="text-2xl md:text-3xl font-bold text-foreground leading-snug mb-6"
        >
          We love to hear from you!
        </h2>
        <div class="space-y-4">
          <!-- Email -->
          <div class="flex justify-between shadow p-4 rounded bg-background">
            <div>
              <h4 class="text-muted">Email Us</h4>
              <p class="text-foreground">support@premiumdesign.com</p>
            </div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              fill="none"
              viewBox="0 0 24 24"
              class="text-muted"
            >
              <path
                d="M7 17L17 7M9 7h8v8"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <!-- Phone -->
          <div class="flex justify-between shadow p-4 rounded bg-bg-background">
            <div>
              <h4 class="text-muted">Call Us</h4>
              <p class="text-foreground">+1234567890</p>
            </div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              fill="none"
              viewBox="0 0 24 24"
              class="text-muted"
            >
              <path
                d="M7 17L17 7M9 7h8v8"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <!-- Address -->
          <div class="flex justify-between shadow p-4 rounded bg-bg-background">
            <div>
              <h4 class="text-muted">Address</h4>
              <p class="text-foreground">
                123 Business Street, San Francisco, CA
              </p>
            </div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              fill="none"
              viewBox="0 0 24 24"
              class="text-muted"
            >
              <path
                d="M7 17L17 7M9 7h8v8"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
