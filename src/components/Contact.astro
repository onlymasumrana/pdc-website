---
// Configuration
const services = [
  'Portfolio Website',
  'UI/UX Design',
  'Web Development',
  'MVP',
  'Branding',
  'No-code (Webflow, Framer)',
];

const budgets = ['Less than $10k', '$10k - $50k', 'More than $50k'];

const FORM_CONFIG = {
  contact: 'https://formspree.io/f/mnnzekna',
  quote: 'https://formspree.io/f/xovnaawz',
};
---

<section>
  <!-- Heading -->
  <div class="mb-3 flex flex-col md:mb-6 md:flex-row md:gap-10">
    <p class="text-sm font-medium uppercase tracking-wider">
      <span class="text-xl text-[#ff6a00]">✷</span> GET IN TOUCH
    </p>

    <div>
      <h2 class="section-title">
        Have
        <span class="text-muted"> ideas to build?</span>
      </h2>
    </div>
  </div>

  <!-- Contact Info & Form  -->
  <div
    class="grid grid-cols-1 rounded border border-border bg-background md:grid-cols-2 lg:p-8">
    <!-- Info section -->
    <div class="flex flex-col justify-between p-8">
      <h2 class="mb-6 text-xl font-semibold md:text-2xl">
        We would love to hear from you!
      </h2>
      <div class="animated-block flex flex-col gap-4">
        <!-- Email -->
        <div
          class="animated-item flex justify-between rounded border border-border-muted bg-background p-4 md:w-2/3">
          <div>
            <p class="font-medium text-muted">Email Us</p>
            <a href="mailto:info.premiumdesigncompany@gmail.com" class="text-foreground">info.premiumdesigncompany@gmail.com</a>
          </div>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            fill="none"
            viewBox="0 0 24 24"
            class="text-muted">
            <path
              d="M7 17L17 7M9 7h8v8"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
        <!-- Phone -->
        <div
          class="animated-item flex justify-between rounded border border-border-muted bg-background p-4 md:w-2/3">
          <div>
            <p class="font-medium text-muted">Call Us</p>
            <a href="tel:+33759440610" class="text-foreground">+33 75 944 06 10</a>
          </div>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            fill="none"
            viewBox="0 0 24 24"
            class="text-muted">
            <path
              d="M7 17L17 7M9 7h8v8"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
        <!-- WhatsApp -->
        <div
          class="animated-item flex justify-between rounded border border-border-muted bg-background p-4 md:w-2/3">
          <div>
            <p class="font-medium text-muted">WhatsApp</p>
            <a
              href="https://wa.me/46769220990"
              target="_blank"
              rel="noopener noreferrer"
              class="text-foreground">
              +46 76 922 09 90
            </a>
          </div>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            fill="none"
            viewBox="0 0 24 24"
            class="text-muted">
            <path
              d="M7 17L17 7M9 7h8v8"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
        <!-- Address -->
        <div
          class="animated-item flex justify-between rounded border border-border-muted bg-background p-4 md:w-2/3">
          <div>
            <p class="font-medium text-muted">Address</p>
            <p class="text-foreground">Gothenburg, Sweden | Paris, France</p>
          </div>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            fill="none"
            viewBox="0 0 24 24"
            class="text-muted">
            <path
              d="M7 17L17 7M9 7h8v8"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Form section -->
    <div class="md:pb-8 md:pr-8">
      <!-- Toggle Buttons -->
      <div
        class="mt-8 flex items-center justify-center px-4 py-4 shadow-sm md:mt-4 md:justify-start md:border-none md:px-0 md:shadow-none">
        <div
          class="inline-flex w-fit rounded-full border-border bg-background shadow-sm">
          <button
            data-type="contact"
            class="active-tab btn-secondary rounded-full rounded-r-none border border-border px-3 py-1.5 text-sm font-medium md:px-4 md:py-2">
            Contact
          </button>
          <button
            data-type="quote"
            class="btn-outline border border-x-0 border-border px-3 py-1.5 text-sm font-medium md:px-4 md:py-2">
            Quote
          </button>
          <a href="/schedule" target="_blank" rel="noopener noreferrer">
            <button
              data-type="schedule"
              class="btn-outline rounded-r-full border border-border px-3 py-1.5 text-sm font-medium md:px-4 md:py-2">
              Schedule
            </button>
          </a>
        </div>
      </div>

      <!-- Contact Form Tab -->
      <form
        method="POST"
        action={FORM_CONFIG.contact}
        class="tab-content animated-block active space-y-6 p-8 md:rounded md:bg-background-muted"
        id="contact-form"
        data-form-type="contact">
        <!-- Name & Email -->
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <label class="animated-item block text-sm font-medium">
            Name *
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              placeholder="Enter your name"
              class="form-input mt-1 w-full"
            />
          </label>
          <label class="animated-item block text-sm font-medium">
            Email *
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              placeholder="Enter your email"
              class="form-input mt-1 w-full"
            />
          </label>
        </div>

        <!-- Subject -->
        <label class="animated-item block text-sm font-medium">
          Subject *
          <input
            type="text"
            id="contact-subject"
            name="subject"
            required
            placeholder="What's this about? (e.g., Project Inquiry, Support, Partnership)"
            class="form-input mt-1 w-full"
          />
        </label>

        <!-- Message -->
        <label class="animated-item block text-sm font-medium">
          Message *
          <textarea
            id="contact-message"
            name="message"
            required
            placeholder="What's on your mind? Share your questions, project ideas, feedback, or anything else you'd like to discuss. The more details you provide, the better we can help you & vice versa!"
            class="form-textarea mt-1 h-40 w-full"></textarea>
        </label>

        <!-- Submit Button -->
        <div class="flex justify-end">
          <button type="submit" class="btn btn-primary p-2 pl-4">
            Send Message
            <div
              class="ml-2 flex items-center justify-center rounded bg-background p-1">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="none"
                viewBox="0 0 24 24"
                class="text-foreground">
                <path
                  d="M7 17L17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
          </button>
        </div>
      </form>

      <!-- Quote Form Tab -->
      <form
        method="POST"
        action={FORM_CONFIG.quote}
        class="tab-content hidden space-y-6 p-8 md:rounded md:bg-background-muted"
        id="quote-form"
        data-form-type="quote">
        <!-- Services -->
        <div>
          <label class="mb-2 block text-sm font-semibold">Services *</label>
          <p class="mb-3 text-sm text-muted">Select all that apply</p>
          <div class="flex flex-wrap gap-2" id="services-container">
            {
              services.map((service) => (
                <button
                  type="button"
                  data-service={service}
                  class="data-[selected=true]:btn-secondary rounded border border-border-muted bg-background px-3 py-1.5 text-sm font-medium transition-colors hover:border-border">
                  {service}
                </button>
              ))
            }
          </div>
          <div id="service-error" class="mt-2 hidden">
            <p class="text-sm text-danger">Please select at least one service</p>
          </div>
          <input type="hidden" name="services" id="selected-services" />
        </div>

        <!-- Budget -->
        <div>
          <label class="mb-2 block text-sm font-semibold">Budget *</label>
          <div class="flex flex-wrap gap-2" id="budgets-container">
            {
              budgets.map((budget) => (
                <button
                  type="button"
                  data-budget={budget}
                  class="data-[selected=true]:btn-secondary rounded border border-border-muted bg-background px-3 py-1.5 text-sm font-medium transition-colors hover:border-border">
                  {budget}
                </button>
              ))
            }
          </div>
          <div id="budget-error" class="mt-2 hidden">
            <p class="text-sm text-danger">Please select a budget</p>
          </div>
          <input type="hidden" name="budget" id="selected-budget" />
        </div>

        <!-- Inputs -->
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <label class="block text-sm font-medium">
            Name *
            <input
              type="text"
              id="quote-name"
              name="name"
              required
              placeholder="Enter your name"
              class="form-input mt-1 w-full"
            />
          </label>
          <label class="block text-sm font-medium">
            Email *
            <input
              type="email"
              id="quote-email"
              name="email"
              required
              placeholder="Enter your email"
              class="form-input mt-1 w-full"
            />
          </label>
        </div>

        <!-- Subject -->
        <label class="block text-sm font-medium">
          Subject *
          <input
            type="text"
            id="quote-subject"
            name="subject"
            required
            placeholder="What's this about? (e.g., Project Inquiry, Support, Partnership)"
            class="form-input mt-1 w-full"
          />
        </label>

        <!-- Message -->
        <label class="block text-sm font-medium">
          Message *
          <textarea
            id="quote-message"
            name="message"
            required
            placeholder="What's on your mind? Share your questions, project ideas, feedback, or anything else you'd like to discuss. The more details you provide, the better we can help you & vice versa!"
            class="form-textarea mt-1 h-40 w-full"></textarea>
        </label>

        <!-- Submit Button -->
        <div class="flex justify-end">
          <button type="submit" class="btn btn-primary p-2 pl-4">
            Get Quote
            <div
              class="ml-2 flex items-center justify-center rounded bg-background p-1">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="none"
                viewBox="0 0 24 24"
                class="text-foreground">
                <path
                  d="M7 17L17 7M9 7h8v8"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
          </button>
        </div>
      </form>

      <!-- Schedule Form Tab -->
      <div
        class="tab-content hidden p-8 md:rounded md:bg-background-muted"
        id="schedule-form">
        <div class="flex h-64 items-center justify-center">
          <p class="text-lg font-medium text-muted">
            Calendar integrated scheduling opened in
            <button onclick="focusScheduleWindow()" class="underline">
              another tab
            </button>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Form Management Classes
  class TabManager {
    constructor() {
      this.tabButtons = document.querySelectorAll('[data-type]');
      this.tabContents = document.querySelectorAll('.tab-content');
      this.init();
    }

    init() {
      this.tabButtons.forEach((button) => {
        button.addEventListener('click', (e) => this.switchTab(e.target));
      });
    }

    switchTab(button) {
      const type = button.getAttribute('data-type');

      // Update tab buttons
      this.tabButtons.forEach((btn) => {
        btn.classList.remove('btn-secondary');
        btn.classList.add('btn-outline');
      });

      button.classList.remove('btn-outline');
      button.classList.add('btn-secondary');

      // Show active tab content
      this.tabContents.forEach((content) => {
        content.classList.add('hidden');
        content.classList.remove('active');
      });

      const activeContent = document.getElementById(`${type}-form`);
      if (activeContent) {
        activeContent.classList.remove('hidden');
        activeContent.classList.add('active');
      }
    }
  }

  class FormValidator {
    static validateRequiredFields(form) {
      const inputs = form.querySelectorAll(
        'input[required], textarea[required]'
      );
      let isValid = true;

      inputs.forEach((input) => {
        if (!input.value.trim()) {
          isValid = false;
          this.showFieldError(input, 'This field is required');
        } else {
          this.clearFieldError(input);
        }
      });

      return isValid;
    }

    static validateEmail(email) {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      return emailRegex.test(email);
    }

    static showFieldError(input, message) {
      let errorElement = input.parentNode.querySelector('.field-error');
      if (!errorElement) {
        errorElement = document.createElement('p');
        errorElement.className = 'field-error text-sm text-danger mt-1';
        input.parentNode.appendChild(errorElement);
      }
      errorElement.textContent = message;
      input.classList.add('border-danger');
    }

    static clearFieldError(input) {
      const errorElement = input.parentNode.querySelector('.field-error');
      if (errorElement) {
        errorElement.remove();
      }
      input.classList.remove('border-danger');
    }
  }

  class SelectionManager {
    constructor(
      containerId,
      hiddenInputId,
      errorElementId,
      allowMultiple = false
    ) {
      this.container = document.getElementById(containerId);
      this.hiddenInput = document.getElementById(hiddenInputId);
      this.errorElement = document.getElementById(errorElementId);
      this.allowMultiple = allowMultiple;
      this.buttons = this.container?.querySelectorAll('button') || [];
      this.selectedValues = [];
      this.init();
    }

    init() {
      this.buttons.forEach((button) => {
        button.addEventListener('click', () => this.select(button));
      });
    }

    select(button) {
      const value =
        button.getAttribute('data-service') ||
        button.getAttribute('data-budget');

      if (this.allowMultiple) {
        // Multiple selection logic for services
        if (button.getAttribute('data-selected') === 'true') {
          // Deselect
          button.removeAttribute('data-selected');
          button.classList.remove('btn-secondary');
          this.selectedValues = this.selectedValues.filter((v) => v !== value);
        } else {
          // Select
          button.setAttribute('data-selected', 'true');
          button.classList.add('btn-secondary');
          this.selectedValues.push(value);
        }
      } else {
        // Single selection logic for budget
        // Remove selection from all buttons
        this.buttons.forEach((btn) => {
          btn.removeAttribute('data-selected');
          btn.classList.remove('btn-secondary');
        });

        // Add selection to clicked button
        button.setAttribute('data-selected', 'true');
        button.classList.add('btn-secondary');
        this.selectedValues = [value];
      }

      // Update hidden input with comma-separated values
      this.hiddenInput.value = this.selectedValues.join(', ');

      // Clear error
      if (this.errorElement) {
        this.errorElement.classList.add('hidden');
      }

      console.log(`Selected: ${this.selectedValues.join(', ')}`);
    }

    getSelectedValue() {
      return this.allowMultiple
        ? this.selectedValues
        : this.selectedValues[0] || '';
    }

    validate() {
      const isValid = this.selectedValues.length > 0;
      if (this.errorElement) {
        this.errorElement.classList.toggle('hidden', isValid);
      }
      return isValid;
    }

    // Get current state without creating new instance
    getCurrentState() {
      const currentValue = this.hiddenInput.value;
      if (this.allowMultiple) {
        return currentValue ? currentValue.split(', ') : [];
      } else {
        return currentValue ? [currentValue] : [];
      }
    }
  }

  class FormSubmitHandler {
    constructor() {
      this.forms = document.querySelectorAll('form[data-form-type]');
      this.serviceManager = null;
      this.budgetManager = null;
      this.init();
    }

    init() {
      // Initialize selection managers once and store them
      this.serviceManager = new SelectionManager(
        'services-container',
        'selected-services',
        'service-error',
        true
      );
      this.budgetManager = new SelectionManager(
        'budgets-container',
        'selected-budget',
        'budget-error',
        false
      );

      this.forms.forEach((form) => {
        form.addEventListener('submit', (e) => this.handleSubmit(e));
      });
    }

    handleSubmit(event) {
      const form = event.target;
      const formType = form.getAttribute('data-form-type');

      console.log(`Validating ${formType} form...`);

      // Validate basic required fields
      if (!FormValidator.validateRequiredFields(form)) {
        console.error('Form validation failed: missing required fields');
        event.preventDefault();
        return;
      }

      // Validate email format
      const emailInput = form.querySelector('input[type="email"]');
      if (emailInput && !FormValidator.validateEmail(emailInput.value)) {
        console.error('Form validation failed: invalid email');
        event.preventDefault();
        FormValidator.showFieldError(
          emailInput,
          'Please enter a valid email address'
        );
        return;
      }

      // Validate quote form specific fields
      if (formType === 'quote') {
        const hasServices = this.serviceManager.getCurrentState().length > 0;
        const hasBudget = this.budgetManager.getCurrentState().length > 0;

        console.log(
          'Services selected:',
          this.serviceManager.getCurrentState()
        );
        console.log('Budget selected:', this.budgetManager.getCurrentState());

        if (!hasServices) {
          console.error('Quote form validation failed: no services selected');
          event.preventDefault();
          this.serviceManager.errorElement.classList.remove('hidden');
        }

        if (!hasBudget) {
          console.error('Quote form validation failed: no budget selected');
          event.preventDefault();
          this.budgetManager.errorElement.classList.remove('hidden');
        }

        if (!hasServices || !hasBudget) {
          return;
        }
      }

      console.log(
        `Form validation passed. Allowing FormSpree to handle submission to: ${form.action}`
      );
    }
  }

  // Main initialization
  document.addEventListener('DOMContentLoaded', function () {
    console.log('🚀 Initializing contact form...');

    try {
      new TabManager();
      new FormSubmitHandler();
      console.log('✅ Contact form initialized successfully');
    } catch (error) {
      console.error('❌ Error initializing contact form:', error);
    }
  });

  // Store reference & open the tab when schedule button is clicked
  let scheduleWindow = null;
  document
    .querySelector('[data-type="schedule"]')
    ?.addEventListener('click', function (e) {
      const link = this.closest('a');
      if (link) {
        e.preventDefault();
        if (scheduleWindow && !scheduleWindow.closed) {
          scheduleWindow.close();
        }
        scheduleWindow = window.open(link.href, '_blank');
        if (scheduleWindow) {
          scheduleWindow.focus();
        }
      }
    });

  function focusScheduleWindow() {
    if (scheduleWindow && !scheduleWindow.closed) {
      scheduleWindow.focus();
    } else {
      const link = document
        .querySelector('[data-type="schedule"]')
        ?.closest('a');
      if (link) {
        scheduleWindow = window.open(link.href, '_blank');
        if (scheduleWindow) {
          scheduleWindow.focus();
        }
      }
    }
  }
</script>
