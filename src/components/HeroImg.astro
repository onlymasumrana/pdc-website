---
const images = [
    "/assets/BG (2).png",
    "/assets/BG (1).png",
    "/assets/BG.png",
    "/assets/BG (2).png"
]
---
<section class="section bg-background rounded-b pb-5 px-7">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-2">
    {images.map((img) => (
      <img 
        src={img} 
        alt=""
      />
    ))}
  </div>
</section>
