---
// src/components/Portfolio.astro
const portfolios = [
  {
    link: 'example.com',
    image: '',
    title: 'Website Design & Development',
    description:
      'Upload your design or website draft and get instant AI-powered analysis with accessibility recommendations.',
    categories: ['SaaS', 'Travel', 'Marketplace'],
    cta: [
      {
        icon: '',
        text: 'View Project',
        link: 'example.com',
        variant: 'primary',
      },
    ],
  },
];
---

<section class="px-6 py-12">
  <header class="section-header">
    <h2 class="section-title text-center">Success Stories</h2>
    <p class="section-subtitle">
      Projects that prove accessibility and great design go hand in hand
    </p>
  </header>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      portfolios.map((portfolio) => (
        <article class="card px-8 py-6 flex flex-col justify-between">
          <div class="card-header">
            <h4 class="card-title">{portfolio.title}</h4>
          </div>
          <div class="card-body flex-grow">
            <p class="">{portfolio.description}</p>
            <p class="font-semibold my-2">Project Cats:</p>
            <ul class="list-disc pl-2">
              {portfolio.categories.map((category) => (
                <li>{category}</li>
              ))}
            </ul>
          </div>
          <div class="card-footer flex justify-center items-center pt-4">
            {portfolio.cta?.map((action) => (
              <a
                href={action.link}
                class={`card-cta ${
                  action.variant === 'primary'
                    ? 'btn-primary'
                    : ''
                }`}>
                {action.text}
              </a>
            ))}
          </div>
        </article>
      ))
    }
  </div>
  <div class="text-center mt-8">
    <a
      href="example.com"
      class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-primary-dark transition"
      >View All Projects</a
    >
  </div>
</section>
