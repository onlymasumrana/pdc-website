---
// src/components/Portfolio.astro
import { Image } from 'astro:assets';
import Card from './Card.astro';

const portfolios = [
  {
    link: 'example.com',
    image:
      'https://images.unsplash.com/photo-1621414154392-4eb9ee0b6f57?q=80&w=880&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
    title: 'AI powered Travel Platform',
    description:
      'Travel booking platform designed for users with diverse needs and abilities.',
    categories: ['SaaS', 'Travel', 'AI'],
    cta: [
      {
        icon: '',
        text: 'View Case Study',
        link: 'example.com',
        variant: 'primary',
      },
    ],
  },
  {
    link: 'example.com',
    image:
      'https://cdn.pixabay.com/photo/2025/08/03/15/10/cat-9752539_960_720.jpg',
    title: 'E-commerce Platform',
    description:
      'E-commerce platform designed for users with diverse needs and abilities.',
    categories: ['E-Commerce', 'Website'],
    cta: [
      {
        icon: '',
        text: 'View Case Study',
        link: 'example.com',
        variant: 'secondary',
      },
    ],
  },
  {
    link: 'example.com',
    image:
      'https://images.unsplash.com/photo-1511275539165-cc46b1ee89bf?q=80&w=1470&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
    title: 'Personal Website',
    description: 'Personal website designed for showcasing portfolios.',
    categories: ['Personal', 'Portfolio'],
    cta: [
      {
        icon: '',
        text: 'View Case Study',
        link: 'example.com',
        variant: 'outline',
      },
    ],
  },
];
---

<section class="section">
  <header class="section-header">
    <h2 class="section-title text-gradient">Success Stories</h2>
    <p class="section-subtitle">
      Projects that prove accessibility and great design go hand in hand
    </p>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      portfolios.map((portfolio) => (
        <Card>
          <img
            slot="card-image"
            src={portfolio.image}
            alt={portfolio.title}
            class="card-image"
          />

          <h4 slot="card-header" class="card-title">
            {portfolio.title}
          </h4>

          <div slot="card-content" class="space-y-3">
            <p class="text-foreground">{portfolio.description}</p>
            <div>
              <p class="font-semibold text-foreground">Cats:</p>
              <ul class="list-disc pl-4 text-foreground">
                {portfolio.categories.map((category) => (
                  <li>{category}</li>
                ))}
              </ul>
            </div>
          </div>

          <div slot="card-footer" class="flex flex-col gap-2">
            {portfolio.cta.map((action) => (
              <a
                href={action.link}
                class={`card-cta ${
                  action.variant === 'primary'
                    ? 'card-cta-primary'
                    : action.variant === 'secondary'
                      ? 'card-cta-secondary'
                      : action.variant === 'outline'
                        ? 'card-cta-outline'
                        : ''
                }`}>
                {action.text}
              </a>
            ))}
          </div>
        </Card>
      ))
    }
  </div>

  <div class="text-center mt-8 md:mt-10 lg:mt-12">
    <a href="/portfolio" class="btn btn-primary">View All Projects</a>
  </div>
</section>
