---
// src/components/Portfolio.astro
import { Image } from 'astro:assets';
import Card from './Card.astro';

const portfolios = [
  {
    link: 'example.com',
    image:
      'https://images.unsplash.com/photo-1621414154392-4eb9ee0b6f57?q=80&w=880&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
    title: 'AI powered Travel Platform',
    description:
      'Travel booking platform designed for users with diverse needs and abilities.',
    categories: ['SaaS', 'Travel', 'AI'],
    cta: [
      {
        icon: '',
        text: 'View Case Study',
        link: 'example.com',
        variant: 'primary',
      },
    ],
  },
  {
    link: 'example.com',
    image:
      'https://cdn.pixabay.com/photo/2025/08/03/15/10/cat-9752539_960_720.jpg',
    title: 'E-commerce Platform',
    description:
      'E-commerce platform designed for users with diverse needs and abilities.',
    categories: ['E-Commerce', 'Website'],
    cta: [
      {
        icon: '',
        text: 'View Case Study',
        link: 'example.com',
        variant: 'secondary',
      },
    ],
  },
  {
    link: 'example.com',
    image:
      'https://images.unsplash.com/photo-1511275539165-cc46b1ee89bf?q=80&w=1470&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
    title: 'Personal Website',
    description: 'Personal website designed for showcasing portfolios.',
    categories: ['Personal', 'Portfolio'],
    cta: [
      {
        icon: '',
        text: 'View Case Study',
        link: 'example.com',
        variant: 'outline',
      },
    ],
  },
];
---

<section class="section">
  <header class="section-header">
    <h2 class="section-title text-gradient">Success Stories</h2>
    <p class="section-subtitle">
      Projects that prove accessibility and great design go hand in hand
    </p>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
    {
      portfolios.map((portfolio) => (
        <Card>
          {/* Image - Ensure it fits the card properly */}
          <img
            slot="card-image"
            src={portfolio.image}
            alt={portfolio.title}
            width="400"
            height="250"
            class="w-full h-48 object-cover"
          />

          {/* Header */}
          <h4
            slot="card-header"
            class="text-xl font-semibold text-foreground mb-2">
            {portfolio.title}
          </h4>

          {/* Content */}
          <div slot="card-content" class="space-y-4">
            <p class="text-muted">{portfolio.description}</p>
            <div>
              <p class="font-medium text-foreground mb-2">Categories:</p>
              <div class="flex flex-wrap gap-2">
                {portfolio.categories.map((category) => (
                  <span class="badge badge-primary">{category}</span>
                ))}
              </div>
            </div>
          </div>

          {/* Footer */}
          <div slot="card-footer" class="space-y-2">
            {portfolio.cta.map((action) => (
              <a
                href={action.link}
                class={`
                  btn btn-sm w-full justify-center
                  ${action.variant === 'primary' ? 'btn-primary' : ''}
                  ${action.variant === 'secondary' ? 'btn-secondary' : ''}
                  ${action.variant === 'outline' ? 'btn-outline' : ''}
                `}>
                {action.text}
              </a>
            ))}
          </div>
        </Card>
      ))
    }
  </div>

  {/* View All Projects Button */}
  <div class="text-center mt-12">
    <a href="/portfolio" class="btn btn-primary btn-lg">View All Projects</a>
  </div>
</section>
