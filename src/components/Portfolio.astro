<section class="section">
  <header class="section-header">
    <h2 class="section-title text-gradient">Success Stories</h2>
    <p class="section-subtitle">
      Projects that prove accessibility and great design go hand in hand
    </p>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
    {
      portfolios.map((portfolio) => (
        <Card>
          {/* Image - Ensure it fits the card properly */}
          <img
            slot="card-image"
            src={portfolio.image}
            alt={portfolio.title}
            width="400"
            height="250"
            class="w-full h-48 object-cover rounded"
          />

          {/* Header */}
          <h4
            slot="card-header"
            class="text-xl font-semibold text-foreground mb-2">
            {portfolio.title}
          </h4>

          {/* Content */}
          <div slot="card-content" class="space-y-4">
            <p class="text-muted">{portfolio.description}</p>
            <div>
              <p class="font-medium text-foreground mb-2">Categories:</p>
              <div class="flex flex-wrap gap-2">
                {portfolio.categories.map((category) => (
                  <span class="badge badge-primary">
                    {category}
                  </span>
                ))}
              </div>
            </div>
          </div>

          {/* Footer */}
          <div slot="card-footer" class="space-y-2">
            {portfolio.cta.map((button) => (
              <a
                href={button.link}
                target={button.target}
                rel={button.rel}
                class={`
                  btn btn-sm w-full justify-center
                  ${button.variant === 'primary' ? 'btn-primary' : ''}
                  ${button.variant === 'secondary' ? 'btn-secondary' : ''}
                  ${button.variant === 'outline' ? 'btn-outline' : ''}
                `}>
                {button.text}
              </a>
            ))}
          </div>
        </Card>
      ))
    }
  </div>

  {/* View All Projects Button */}
  <div class="text-center mt-12">
    <a href="/portfolio" class="btn btn-primary btn-lg">View All Projects</a>
  </div>
</section> -->
