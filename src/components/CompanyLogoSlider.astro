--- 
const logos = [
  "/assets/impact.png",
  "/assets/kodekloud.png",
  "/assets/smartmail.png",
  "/assets/wandr.png",
  "/assets/impact.png"
]; 
---

<section class="section">
  <header class="section-header text-center mb-8">
    <h2 class="section-title text-gradient text-2xl md:text-3xl font-bold">
      Trusted by Leading Brands
    </h2>
    <p class="section-subtitle text-gray-400 text-sm md:text-base">
      Our work is recognized by industry leaders worldwide
    </p>
  </header>

  <!-- Logo Slider -->
  <div class="overflow-hidden relative p-4 px-2 w-svw  mx-auto">
    <div id="logo-track" class="flex animate-scroll">
      {[...logos, ...logos].map((logo) => (
        <div class="flex items-center justify-center flex-shrink-0 px-6 sm:px-8 md:px-12">
          <img
            src={logo}
            alt="Brand Logo"
            class="h-10 sm:h-12 md:h-16 w-auto grayscale hover:grayscale-0 transition-all duration-300"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* smooth infinite scrolling */
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  #logo-track {
    width: max-content;
    display: flex;
    animation: scroll 25s linear infinite;
  }

  /* pause on hover */
  #logo-track:hover {
    animation-play-state: paused;
  }

  /* responsive speed control */
  @media (max-width: 640px) {
    #logo-track {
      animation: scroll 60s linear infinite; /* Mobile → slowest */
    }
  }

  @media (min-width: 641px) and (max-width: 1023px) {
    #logo-track {
      animation: scroll 40s linear infinite; /* Tablet → medium */
    }
  }

  @media (min-width: 1024px) {
    #logo-track {
      animation: scroll 25s linear infinite; /* Desktop → fastest */
    }
  }
</style>
