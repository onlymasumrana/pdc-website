---
const logos = [
  '/assets/impact.png',
  '/assets/kodekloud.png',
  '/assets/smartmail.png',
  '/assets/wandr.png',
  '/assets/impact.png',
  '/assets/kodekloud.png',
  '/assets/smartmail.png',
  '/assets/wandr.png',
  '/assets/impact.png',
  '/assets/kodekloud.png',
  '/assets/smartmail.png',
  '/assets/wandr.png',
  '/assets/impact.png',
  '/assets/kodekloud.png',
  '/assets/smartmail.png',
  '/assets/wandr.png',
];
---

<section class="">
  <!-- Logo Slider -->
  <div class="relative mx-auto max-w-[90vw] overflow-hidden">
    <div id="logo-track" class="animate-scroll flex">
      {
        logos.map((logo) => (
          <div class="flex flex-shrink-0 items-center justify-center">
            <div class="mx-4 flex h-16 items-center justify-center rounded bg-background px-4 py-3">
              <img
                src={logo}
                alt="Brand Logo"
                class="h-10 w-auto grayscale transition-all duration-300 hover:grayscale-0 dark-invert-logo"
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Invert logos in dark theme */
  :global([data-theme="neutral-dark"]) .dark-invert-logo {
    filter: invert(1) brightness(2) grayscale(1);
  }
  :global([data-theme="neutral-dark"]) .dark-invert-logo:hover {
    filter: invert(1) brightness(2) grayscale(0);
  }

  /* smooth infinite scrolling */
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  #logo-track {
    width: max-content;
    max-width: 100%;
    display: flex;
    animation: scroll 6s linear infinite;
  }

  /* pause on hover */
  #logo-track:hover {
    animation-play-state: paused;
  }

  @media (min-width: 641px) {
    #logo-track {
      animation: scroll 10s linear infinite;
    }
  }

  @media (min-width: 1024px) {
    #logo-track {
      animation: scroll 15s linear infinite;
    }
  }
</style>
