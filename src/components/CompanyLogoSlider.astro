---
const logos = [
  '/assets/impact.png',
  '/assets/kodekloud.png',
  '/assets/smartmail.png',
  '/assets/wandr.png',
  '/assets/impact.png',
  '/assets/impact.png',
  '/assets/kodekloud.png',
  '/assets/smartmail.png',
  '/assets/wandr.png',
  '/assets/impact.png',
];
---

<section class="section">
  <!-- Logo Slider -->
  <div class="relative mx-auto max-w-[90vw] overflow-hidden">
    <div id="logo-track" class="animate-scroll flex">
      {
        logos.map((logo) => (
          <div class="flex flex-shrink-0 my-8 items-center justify-center">
            <img
              src={logo}
              alt="Brand Logo"
              class="h-20 w-auto px-4 py-3 rounded mx-4 bg-background grayscale transition-all duration-300 hover:grayscale-0 md:h-16"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* smooth infinite scrolling */
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  #logo-track {
    width: max-content;
    max-width: 100%;
    display: flex;
    animation: scroll 25s linear infinite;
  }

  /* pause on hover */
  #logo-track:hover {
    animation-play-state: paused;
  }

  /* responsive speed control */
  @media (max-width: 640px) {
    #logo-track {
      animation: scroll 60s linear infinite; /* Mobile → slowest */
    }
  }

  @media (min-width: 641px) and (max-width: 1023px) {
    #logo-track {
      animation: scroll 40s linear infinite; /* Tablet → medium */
    }
  }

  @media (min-width: 1024px) {
    #logo-track {
      animation: scroll 25s linear infinite; /* Desktop → fastest */
    }
  }
</style>
