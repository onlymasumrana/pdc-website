---

---

<section class="section bg-background px-7 rounded-t-lg">
  <div class="flex flex-col md:flex-row md:justify-between gap-12 items-end">
    <!-- Left side (Text + Button) -->
    <div class="flex-1 space-y-5">
      <p class="uppercase tracking-wide font-medium">
        Welcome to Premium Design Company <span style="color: rgb(255, 162, 0); font-size: 40px;">✷</span>

      </p>
      <h1 class="section-title leading-tight">
        Premium Design <br />
        Services With <br />
        Exceptional Price
      </h1>
      <a href="#" class="btn btn-lg btn-primary">
        Get Started Now
        <div
          class="bg-background rounded inline-flex items-center justify-center ml-2 p-2"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            fill="none"
            viewBox="0 0 24 24"
            class="text-foreground"
          >
            <path
              d="M7 17L17 7M9 7h8v8"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </a>
    </div>

    <!-- Right side (Portfolio link + Icon + Paragraph) -->
    <div class="flex-1">
      <div class="flex justify-between items-end">
        <a href="#" class="uppercase font-bold underline leading-snug">
          View All <br />Portfolio
        </a>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="96"
          height="96"
          fill="none"
          viewBox="0 0 14 24"
          class="w-60 h-60 text-muted"
        >
          <path
            d="M7 17L17 7M9 7h8v8"
            stroke="currentColor"
            stroke-width="1"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>
      <p class="mt-4 text-muted">
        We design innovative websites, applications, and brands that are
        beautifully crafted for all users. Emphasizing accessibility,
        inclusivity, and driven by cutting-edge AI technology.
      </p>
    </div>
  </div>
</section>

