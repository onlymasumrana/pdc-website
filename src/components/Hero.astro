---
import { Swiper, SwiperWrapper, SwiperSlide } from 'astro-swiper';

const portfolioImages = ['/assets/spacex.png', '/assets/aerosense.png'];
---

<section class="section rounded bg-background">
  <div class="flex flex-col justify-between md:p-8 lg:flex-row">
    <div class="flex flex-1 flex-col items-start justify-between p-8">
      <p class="text-sm font-medium uppercase tracking-wider">
        Welcome to Premium Design Company
        <span class="text-xl uppercase text-[#ff6a00]"> ✷</span>
      </p>
      <h1 class="section-title">
        Premium Design Services With Exceptional Price
      </h1>
      <p class="text-muted">
        We design innovative websites, applications, and brands that are
        beautifully crafted for all users. Emphasizing accessibility,
        inclusivity, and driven by cutting-edge AI technology.
      </p>
      <a
        href="#"
        class="btn btn-primary mt-4 inline-flex items-center p-2 pl-4">
        Get Started Now
        <div
          class="ml-2 inline-flex items-center justify-center rounded bg-background p-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="none"
            viewBox="0 0 24 24"
            class="text-foreground">
            <path
              d="M7 17L17 7M9 7h8v8"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </a>
    </div>
    <div class="flex flex-1 items-center justify-center p-8">
      <div class="testimonial-carousel w-full max-w-md">
        <Swiper
          options={{
            slidesPerView: 1,
            spaceBetween: 16,
            loop: true,
            autoplay: {
              delay: 5000,
              disableOnInteraction: false,
            },
            breakpoints: {
              640: {
                slidesPerView: 1,
              },
              1024: {
                slidesPerView: 1,
              },
            },
          }}>
          <SwiperWrapper>
            {
              portfolioImages.map((image) => (
                <SwiperSlide>
                  <div class="flex items-center justify-center">
                    <img
                      src={image}
                      alt="Portfolio Image"
                      class="max-w-full overflow-hidden rounded object-contain transition"
                    />
                  </div>
                </SwiperSlide>
              ))
            }
          </SwiperWrapper>
        </Swiper>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonial-carousel {
    width: 100%;
    overflow: hidden;
  }

  .swiper {
    width: 100%;
    padding-bottom: 1rem;
  }

  .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .swiper-slide img {
      height: 24rem !important;
      padding: 1rem !important;
    }
  }
</style>
