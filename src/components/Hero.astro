---
// src/components/Hero.astro
---

<section class="section text-center">
  <div class="section-header">
    <h1 class="section-title text-gradient">
      Build Accessible Brands with AI + Creativity
    </h1>
    <p class="section-subtitle">
      We create websites, apps, and brands that work beautifully for everyone.
      Accessible, powered by AI.
    </p>
  </div>
  <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
    <a href="/consultation" class="btn btn-primary btn-lg">
      Access Free Consultation
    </a>
    <a
      href="/works"
      class="btn btn-outline btn-lg"
      onclick="handleWorksClick(event)">
      View Our Work
    </a>
  </div>

  <script is:inline>
    function handleWorksClick(event) {
      // If already on homepage, scroll to works section
      if (window.location.pathname === '/') {
        event.preventDefault();
        const worksSection = document.querySelector('#works');
        if (worksSection) {
          worksSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
      // Otherwise, the regular href="/works" will navigate to works page
    }
  </script>
</section>
