---
// src\components\Hero.astro
const portfolioImages = [
  { src: '/assets/spacex.png', alt: 'SpaceX Project' },
  { src: '/assets/aerosense.png', alt: 'AeroSense Project' },
  { src: '/assets/ranty.png', alt: 'Ranty Project' },
];
---

<section class="rounded bg-background">
  <div class="flex flex-col justify-between md:p-8 lg:flex-row">
    <div class="flex-col items-start justify-between p-4 md:p-8">
      <p class="text-sm font-medium uppercase tracking-wider">
        Welcome to Premium Design Company
        <span class="text-xl uppercase text-[#ff6a00]"> ✷</span>
      </p>
      <h1 class="section-title mt-2">
        Premium Design Services With Exceptional Price
      </h1>
      <p class="text-muted">
        We design innovative websites, applications, and brands that are
        beautifully crafted for all users. Emphasizing accessibility,
        inclusivity, and driven by cutting-edge AI technology.
      </p>
      <a
        href="#"
        class="btn btn-primary mt-6 inline-flex items-center p-2 pl-4 md:mt-8">
        Get Started Now
        <div
          class="ml-2 inline-flex items-center justify-center rounded bg-background p-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="none"
            viewBox="0 0 24 24"
            class="text-foreground">
            <path
              d="M7 17L17 7M9 7h8v8"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </a>
    </div>
    <div class="hidden items-center justify-end p-4 lg:flex md:p-8">
      <div class="w-full md:max-w-sm lg:max-w-md">
        <div class="h-full overflow-hidden rounded">
          <div class="swiper portfolio-carousel">
            <div class="swiper-wrapper">
              {
                portfolioImages.map((image, index) => (
                  <div
                    class="swiper-slide flex h-full items-center justify-center">
                    <img
                      src={image.src}
                      alt={image.alt}
                      class="max-h-full max-w-full rounded object-contain transition"
                    />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .portfolio-carousel {
    height: 100%;
  }
</style>

<script>
  import { Swiper } from 'swiper';
  import { Autoplay } from 'swiper/modules';
  import 'swiper/css';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSwiper);
  } else {
    initSwiper();
  }

  function initSwiper() {
    new Swiper('.portfolio-carousel', {
      modules: [Autoplay],
      spaceBetween: 0,
      slidesPerView: 1,
      loop: true,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
      breakpoints: {
        640: {
          spaceBetween: 16,
        },
      },
    });
  }
</script>
