---
---
<section class="section bg-background px-2 md:px-7  rounded-t-lg">
  <div class="flex flex-col md:flex-row md:justify-between gap-10 lg:gap-16 items-start md:items-end">
    
    <!-- Left side (Text + Button) -->
    <div class="flex-1 space-y-5">
      <p class="text-sm font-medium flex items-center justify-center md:justify-start">
        Welcome to Premium Design Company
        <span class="ml-1" style="color: rgb(255, 106, 0); font-size: 23px;">✷</span>
      </p>
      <h1 class="section-title leading-tight text-3xl sm:text-4xl lg:text-5xl font-bold">
        Premium Design <br />
        Services With <br />
        Exceptional Price
      </h1>
      <a href="#" class="btn btn-lg btn-primary inline-flex items-center">
        Get Started Now
        <div
          class="bg-background rounded inline-flex items-center justify-center ml-2 p-2"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            fill="none"
            viewBox="0 0 24 24"
            class="text-foreground"
          >
            <path
              d="M7 17L17 7M9 7h8v8"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </a>
    </div>

     <!-- Right side (Portfolio link + Icon + Paragraph) -->
    <div class="flex-1">
      <div class="flex justify-between items-end">
        <a href="#" class="uppercase font-bold underline leading-snug">
          View All <br />Portfolio
        </a>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="96"
          height="96"
          fill="none"
          viewBox="0 0 14 24"
          class="w-60 h-60 text-muted"
        >
          <path
            d="M7 17L17 7M9 7h8v8"
            stroke="currentColor"
            stroke-width="1"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>
      <p class="mt-4 text-muted">
        We design innovative websites, applications, and brands that are
        beautifully crafted for all users. Emphasizing accessibility,
        inclusivity, and driven by cutting-edge AI technology.
      </p>
    </div>
  </div>
</section>


