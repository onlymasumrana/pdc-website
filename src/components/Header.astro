---
// src/components/Header.astro
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
---

<header
  class="sticky top-0 z-50 bg-background/95 backdrop-blur-3xl border-b border-border">
  <div class="p-6">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <Image
          src={logo}
          alt="Premium Design Company Logo"
          width={32}
          height={32}
          class="flex-shrink-0"
        />
        <span class="font-bold text-3xl pb-1 text-gradient">Premium Design</span
        >
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-8">
        <a
          href="/"
          class="nav-link nav-link-active"
          onclick="handleHomeClick(event)">Home</a
        >
        <a
          href="/services"
          class="nav-link"
          onclick="handleServicesClick(event)">Services</a
        >
        <a href="/works" class="nav-link" onclick="handleWorksClick(event)"
          >Works</a
        >
        <a href="/contact" class="nav-link">Contact</a>
        <a href="/consultation" class="btn btn-primary btn-lg">
          Free Consultation
        </a>
      </nav>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="md:hidden p-2 rounded text-foreground border border-border-muted"
        aria-label="Toggle mobile menu"
        onclick="toggleMobileMenu()">
        <svg
          id="menu-icon"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="close-icon"
          class="h-6 w-6 hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <nav id="mobile-nav" class="md:hidden relative border-t border-border-muted hidden">
    <div
      class="absolute top-0 left-0 w-screen px-12 pb-12 pt-6 space-y-6 bg-background-muted border-b border-border">
      <a
        href="/"
        class="block py-2 text-xl nav-link nav-link-active"
        onclick="handleMobileHomeClick(event)">Home</a
      >
      <a
        href="/services"
        class="block py-2 text-xl nav-link"
        onclick="handleMobileServicesClick(event)">Services</a
      >
      <a
        href="/works"
        class="block py-2 text-xl nav-link"
        onclick="handleMobileWorksClick(event)">Works</a
      >
      <a
        href="/contact"
        class="block py-2 text-xl nav-link"
        onclick="closeMobileMenu()">Contact</a
      >
      <a
        href="/consultation"
        class="btn btn-primary btn-lg w-full justify-center mt-4"
        onclick="closeMobileMenu()">
        Free Consultation
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  // Toggle mobile menu
  function toggleMobileMenu() {
    const mobileNav = document.getElementById('mobile-nav');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    if (mobileNav.classList.contains('hidden')) {
      mobileNav.classList.remove('hidden');
      menuIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
      // document.body.style.overflow = 'hidden'; //making this hidden will prevent scrolling, commented out for testing purposes
    } else {
      mobileNav.classList.add('hidden');
      menuIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
      document.body.style.overflow = 'auto';
    }
  }

  // Close mobile menu
  function closeMobileMenu() {
    const mobileNav = document.getElementById('mobile-nav');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    mobileNav.classList.add('hidden');
    menuIcon.classList.remove('hidden');
    closeIcon.classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  // Mobile navigation handlers
  function handleMobileHomeClick(event) {
    closeMobileMenu();
    handleHomeClick(event);
  }

  function handleMobileServicesClick(event) {
    closeMobileMenu();
    handleServicesClick(event);
  }

  function handleMobileWorksClick(event) {
    closeMobileMenu();
    handleWorksClick(event);
  }

  // Original navigation handlers
  function handleHomeClick(event) {
    // If already on homepage, scroll to top
    if (window.location.pathname === '/') {
      event.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    // Otherwise, the regular href="/" will navigate to homepage
  }

  function handleServicesClick(event) {
    // If already on homepage, scroll to services section
    if (window.location.pathname === '/') {
      event.preventDefault();
      const servicesSection = document.querySelector('#services');
      if (servicesSection) {
        servicesSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
    // Otherwise, the regular href="/services" will navigate to services page
  }

  function handleWorksClick(event) {
    // If already on homepage, scroll to works section
    if (window.location.pathname === '/') {
      event.preventDefault();
      const worksSection = document.querySelector('#works');
      if (worksSection) {
        worksSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
    // Otherwise, the regular href="/works" will navigate to works page
  }

  // Handle direct URL hashes on homepage
  document.addEventListener('DOMContentLoaded', function () {
    if (window.location.pathname === '/') {
      const hash = window.location.hash;
      if (hash === '#services' || hash === '#works') {
        const section = document.querySelector(hash);
        if (section) {
          setTimeout(() => {
            section.scrollIntoView({ behavior: 'smooth' });
          }, 100);
        }
      }
    }
  });
</script>
