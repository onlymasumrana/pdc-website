---
const faqs = [
  {
    question: "What is the purpose of this product?",
    answer:
      "Our product revolutionizes user engagement with cutting-edge design and flawless functionality, ensuring an unparalleled experience for every user across all platforms.",
  },
  {
    question: "How do I set up my account?",
    answer:
      "To set up your account, simply sign up with your email, verify it, and complete your profile. You’ll be ready to start using our services right away.",
  },
  {
    question: "Can I change my subscription plan?",
    answer:
      "Yes, you can easily upgrade or downgrade your subscription anytime from the account settings page.",
  },
  {
    question: "What should I do if I encounter a technical issue?",
    answer:
      "If you face any technical issues, please reach out to our support team via chat or email. We’re always here to help you quickly resolve any problem.",
  },
  {
    question: "How can I contact customer support?",
    answer:
      "You can contact us anytime through live chat, email, or our support page. Our team is available 24/7.",
  },
];
---

<section class="section p-4">
  <div class="flex flex-col md:flex-row">
    <!-- Heading -->
    <div class="mb-10 md:w-1/3">
      <p class="text-sm font-medium flex items-center"><span style="color: rgb(255, 106, 0); font-size: 20px;">✷</span> FAQ</p>
      <h2 class="text-section-title">
        <span class="muted">Your possible</span> <br/> 
        <span class="foreground">question answer</span> 
      </h2>
    </div>

    <!-- FAQ List -->
    <div class="space-y-4 md:w-2/3">
      {faqs.map((faq) => (
        <details class="group rounded-2xl p-5 bg-background">
          <summary class="flex justify-between items-center cursor-pointer font-semibold text-lg list-none">
            {faq.question}
            <!-- plus/minus toggle -->
            <span class="ml-2 text-xl before:content-['+'] group-open:before:content-['-']"></span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed">
            {faq.answer}
          </p>
        </details>
      ))}

      <!-- Footer -->
      <div class="mt-12 text-sm flex justify-between pb-2 border-b">
        <p>
          STILL HAVE QUESTIONS? WE’RE ALWAYS HERE <br />
          TO HELP YOU OUT ANYTIME.
        </p>
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="44"
            height="44"
            fill="none"
            viewBox="0 0 24 24"
            class="text-foreground"
          >
            <path
              d="M7 17L17 7M9 7h8v8"
              stroke="currentColor"
              stroke-width="1"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
      </div>
    </div>
  </div>
</section>


