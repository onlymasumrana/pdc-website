---
const faqs = [
  {
    question: 'What is the purpose of this product?',
    answer:
      'Our product revolutionizes user engagement with cutting-edge design and flawless functionality, ensuring an unparalleled experience for every user across all platforms.',
  },
  {
    question: 'How do I set up my account?',
    answer:
      'To set up your account, simply sign up with your email, verify it, and complete your profile. You’ll be ready to start using our services right away.',
  },
  {
    question: 'Can I change my subscription plan?',
    answer:
      'Yes, you can easily upgrade or downgrade your subscription anytime from the account settings page.',
  },
  {
    question: 'What should I do if I encounter a technical issue?',
    answer:
      'If you face any technical issues, please reach out to our support team via chat or email. We’re always here to help you quickly resolve any problem.',
  },
  {
    question: 'How can I contact customer support?',
    answer:
      'You can contact us anytime through live chat, email, or our support page. Our team is available 24/7.',
  },
];
---

<section class="">
  <div class="flex flex-col md:flex-row md:justify-between md:gap-8">
    <!-- Heading -->
    <div class="mb-3 flex flex-col md:mb-6 md:flex-row md:gap-10">
      <p class="text-sm font-medium uppercase tracking-wider">
        <span class="mr-1 text-xl uppercase text-[#ff6a00]">✷</span>FAQS
      </p>
      <h2 class="section-title">
        <span class="text-foreground">Your possible questions, </span>
        <span class="text-muted"> answered</span>
      </h2>
    </div>

    <!-- FAQ List -->
    <div class="flex flex-col gap-4 md:w-2/3">
      {
        faqs.map((faq) => (
          <details class="group rounded bg-background p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between text-lg font-semibold">
              {faq.question}
              {/* plus/minus toggle */}
              <span class="ml-4 text-xl before:content-['+'] group-open:before:content-['-']" />
            </summary>
            <p class="mt-3 text-base leading-relaxed">{faq.answer}</p>
          </details>
        ))
      }
      <!-- Footer -->
      <div class="flex justify-end px-2 text-sm text-foreground-muted">
        <p>
          More questions?
          <a
            href="/contact"
            class="inline-flex items-center gap-1 font-bold text-foreground-muted underline"
            onclick="handleContactClick(event)">Reach Us</a
          >
        </p>
      </div>
    </div>
  </div>
</section>
<script is:inline>
  function handleContactClick(event) {
    // If already on homepage, scroll to contact section
    if (window.location.pathname === '/') {
      event.preventDefault();
      const contactSection = document.querySelector('#contact');
      if (contactSection) {
        contactSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
    // Otherwise, the regular href="/projects" will navigate to works page
  }
</script>
