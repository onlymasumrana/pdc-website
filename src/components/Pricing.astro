---
const plans = [
  {
    title: "Pro",
    description: "Perfect for small businesses",
    price: "$35",
    yearly: "$420 Billed Yearly",
    buttonText: "Contact Us",
    buttonStyle: "btn btn-primary btn-sm mt-2",
    features: ["Unlimited projects", "Advanced analytics", "All integrations", "Email & chat support"],
  },
  {
    title: "Business",
    description: "Great for growing teams",
    price: "$59",
    yearly: "$708 Billed Yearly",
    buttonText: "Contact Us",
    buttonStyle: "btn btn-outline btn-sm mt-2",
    features: ["Unlimited projects", "Priority analytics", "All integrations", "24/7 Support"],
  },
  {
    title: "Enterprise",
    description: "For large organisations",
    price: "$99",
    yearly: "$1188 Billed Yearly",
    buttonText: "Contact Us",
    buttonStyle: "btn btn-outline btn-sm mt-2",
    features: ["Unlimited everything", "Dedicated analytics", "Custom integrations", "Dedicated account manager"],
  },
];
---

<section class="section flex flex-col md:flex-row gap-5 justify-between">
  {plans.map((plan) => (
    <div class="rounded-2xl bg-[var(--color-background)]  pr-32 pl-10 py-5 shadow-lg">
      <h2 class="font-bold">{plan.title}</h2>
      <p class="mt-1">{plan.description}</p>

      <a href="/consultation" class={plan.buttonStyle}>
        {plan.buttonText}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            d="M7 17L17 7M9 7h8v8"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>

      <div class="mt-6">
        <p class="text-3xl font-semibold">
          {plan.price} <span class="text-base font-normal">/month</span>
        </p>
        <p class="text-sm">{plan.yearly}</p>
      </div>

      <hr class="my-6" />

      <ul class="space-y-3">
        {plan.features.map((feature) => (
          <li class="flex items-center gap-2">
            <span>+</span> {feature}
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>
