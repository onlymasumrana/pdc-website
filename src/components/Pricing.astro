---
const plans = [
  {
    title: 'Pro',
    description: 'Perfect for small business',
    price: '$1750',
    buttonText: 'Get Pro Plan',
    buttonStyle: 'btn btn-outline p-2 pl-4 text-sm',
    features: [
      { text: '40 hours of dedicated design support', included: true },
      { text: 'Full-Stack Delivery Team', included: true },
      { text: 'Daily communication (Slack, Google Meet)', included: true },
      { text: '1 active request per team member', included: true },
      { text: 'Hours rollover', included: true },
      { text: '4 meetings per month', included: true },
      { text: 'Same-day response time', included: true },
      { text: 'Weekly updates and monthly reports', included: true },
      { text: 'Advanced analytics dashboard', included: false },
      { text: 'Dedicated Account Manager', included: false },
      { text: 'Custom analytics and reporting', included: false },
      { text: 'Custom integrations and white-label options', included: false },
    ],
  },
  {
    title: 'Business',
    description: 'Perfect for small-medium businesses',
    cardStyles: 'shadow-lg border',
    price: '$3500',
    buttonText: 'Get Business Plan',
    buttonStyle: 'btn btn-primary p-2 pl-4 text-sm',
    features: [
      { text: '80 hours of dedicated design support', included: true },
      { text: 'Full-Stack Delivery Team', included: true },
      { text: 'Daily communication (Slack, Google Meet)', included: true },
      { text: '2 active requests per team member', included: true },
      { text: 'Hours rollover', included: true },
      { text: '8 meetings per month', included: true },
      { text: 'Priority same-day response time', included: true },
      { text: 'Bi-weekly updates and monthly reports', included: true },
      { text: 'Advanced analytics dashboard', included: true },
      { text: 'Dedicated Account Manager', included: false },
      { text: 'Custom analytics and reporting', included: false },
      { text: 'Custom integrations and white-label options', included: false },
    ],
  },
  {
    title: 'Enterprise',
    description: 'Perfect for medium-large businesses',
    price: '$9000',
    buttonText: 'Get Enterprise Plan',
    buttonStyle: 'btn btn-outline p-2 pl-4 text-sm',
    features: [
      { text: '160 hours of dedicated design support', included: true },
      { text: 'Full-Stack Delivery Team', included: true },
      { text: '24/7 communication (Slack, Google Meet)', included: true },
      { text: 'Unlimited active requests', included: true },
      { text: 'Hours rollover', included: true },
      { text: 'Unlimited meetings', included: true },
      { text: 'Immediate response time', included: true },
      { text: 'Daily updates and comprehensive monthly reports', included: true },
      { text: 'Advanced analytics dashboard', included: true },
      { text: 'Dedicated Account Manager', included: true },
      { text: 'Custom analytics and reporting', included: true },
      { text: 'Custom integrations and white-label options', included: true },
    ],
  },
];
---

<section class="">
  <!-- Heading -->
  <div class="mb-3 flex flex-col md:mb-6 md:flex-row md:gap-10">
    <p class="text-sm font-medium uppercase tracking-wider">
      <span class="mr-1 text-xl text-[#ff6a00]">✷</span>PRICING
    </p>
    <h2 class="section-title">
      <span class="text-foreground">Pricing</span>
      <span class="text-muted">Plan</span>
    </h2>
  </div>

  <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
    {
      plans.map((plan) => (
        <div
          class={
            (plan.cardStyles ? `${plan.cardStyles} ` : '') +
            'animated-block flex flex-col rounded bg-background p-8'
          }>
          <h2 class="mb-4 font-bold">{plan.title}</h2>
          <p class="text-2xl font-semibold">
            {plan.price}
            <span class="text-base font-normal text-foreground-muted">
              /month
            </span>
          </p>
          <p class="mt-1">{plan.description}</p>

          <hr class="my-6 border-t border-border-muted bg-transparent" />
          <ul class="flex-grow space-y-3 px-1">
            {plan.features.map((feature) => (
              <li class={`flex items-start gap-2 ${!feature.included ? 'opacity-50' : ''}`}>
                <span class="font-medium text-foreground-muted">
                  {feature.included ? '+' : '−'}
                </span>
                <span class={feature.included ? 'font-medium text-foreground-muted' : 'text-foreground-muted line-through'}>
                  {feature.text}
                </span>
              </li>
            ))}
          </ul>

          <hr class="my-6 border-t border-border-muted bg-transparent" />

          <div class="flex justify-end">
            <a
              href="/contact"
              onclick="handleContactClick(event)"
              class={plan.buttonStyle}>
              {plan.buttonText}
              <div class="ml-2 inline-flex items-center justify-center rounded bg-background p-1">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  fill="none"
                  viewBox="0 0 24 24"
                  class="text-foreground">
                  <path
                    d="M7 17L17 7M9 7h8v8"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>
            </a>
          </div>
        </div>
      ))
    }
  </div>
  <div class="m-2 hidden text-right text-sm text-foreground-muted">
    <a href="/plans" class="font-semibold capitalize text-foreground-muted underline">
      Know more</a
    > or
    <a class="font-semibold text-foreground-muted capitalize underline" href="/contact" onclick="handleContactClick(event)"
      >Find alternatives</a
    >
  </div>
</section>
<script is:inline>
  function handleContactClick(event) {
    // If already on homepage, scroll to contact section
    if (window.location.pathname === '/') {
      event.preventDefault();
      const contactSection = document.querySelector('#contact');
      if (contactSection) {
        contactSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
    // Otherwise, the regular href="/contact" will navigate to contact page
  }
</script>
