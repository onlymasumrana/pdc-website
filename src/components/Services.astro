---
const services = [
  {
    title: 'Web Design',
    description:
      'Transform user interactions with intuitive, human-centered designs. We craft seamless digital experiences through UI/UX design, product design, wireframing, and prototyping that drives engagement and conversion.',
    features: ['UI/UX Design', 'Product Design', 'User Research', 'Wireframing & Prototyping'],
  },
  {
    title: 'Web Development',
    description:
      'Create robust, scalable web applications with modern technologies. We develop responsive, high-performance solutions using full-stack development, backend systems, and e-commerce platforms.',
    features: ['Full Stack Development', 'Backend Development', 'e-Commerce (Shopify, WooCommerce)', 'React, Next.js, Astro'],
  },
  {
    title: 'Portfolio',
    description:
      'Showcase your work with stunning portfolio websites that highlight your expertise and attract clients and opportunities with visually compelling, responsive designs.',
    features: ['Portfolio Websites', 'Case Study Design', 'Project Showcase', 'Personal Branding'],
  },
  {
    title: 'No-Code',
    description:
      'Build professional websites faster with no-code platforms. We create responsive, conversion-optimized websites using Framer and Webflow without compromising on design quality.',
    features: ['Framer Development', 'Webflow Development', 'Conversion Optimization', 'Design-First Approach'],
  },
  {
    title: 'MVP',
    description:
      'Launch your SaaS/AI products faster with MVP development. We help validate your ideas quickly by building core-feature MVPs that attract early adopters and provide valuable market feedback.',
    features: ['SaaS MVP Design & Development', 'AI Product Development', 'Market Validation', 'Rapid Prototyping'],
  },
  {
    title: 'Branding',
    description:
      'Establish a memorable brand identity that resonates with your audience through comprehensive agency rebranding and visual identity systems.',
    features: ['Full Agency Rebranding', 'Logo Design', 'Print Design', 'Graphics & Visual Identity'],
  },
];
---

<section class="">
  <div class="">
    <!-- Heading -->
    <div class="mb-3 flex flex-col md:mb-6 md:flex-row md:gap-10">
      <p class="text-sm font-medium uppercase tracking-wider">
        <span class="mr-1 text-lg text-[#ff6a00]">✷</span>SERVICES
      </p>
      <h2 class="section-title max-w-3xl">
        Elevate your brand
        <span class="text-muted">with exceptional design solutions</span>
      </h2>
    </div>
    <!-- Services cards  -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service, index) => (
          <div
            class={`animated-service-card hover:border-primary/30 group rounded border border-border-muted bg-background p-6 transition-all duration-300 hover:shadow-lg ${index >= 4 ? 'md:col-span-2' : 'col-span-1'}`}>
            <div class="text-xl text-primary">+</div>
            <h3 class="mb-3 mt-4 text-xl font-semibold text-foreground group-hover:text-primary">
              {service.title}
            </h3>
            <p class="mb-4 text-sm leading-relaxed text-muted">
              {service.description}
            </p>
            <ul class="space-y-2">
              {service.features.map((feature) => (
                <li class="flex items-center text-sm font-semibold text-foreground-muted">
                  <svg class="mr-2 h-3 w-3 flex-shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <!-- View all services button (hidden to match live site) -->
    <div class="mx-auto mt-12 hidden text-center">
      <a href="/services" class="btn btn-primary p-2 pl-4">
        View All Services
        <div class="ml-2 inline-flex items-center justify-center rounded bg-background p-1">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="none"
            viewBox="0 0 24 24"
            class="text-foreground">
            <path
              d="M7 17L17 7M9 7h8v8"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </a>
    </div>
  </div>
</section>
