---

<section class="section">
  <div class="">
     <!-- Heading -->
    <div class="mb-3 md:mb-6 flex flex-col md:flex-row md:gap-10">
      <p class="text-sm font-medium uppercase tracking-wider "><span style="color: rgb(255, 106, 0); font-size: 20px;">✷</span>PRICING</p>
        <h2 class="section-title flex flex-wrap gap-2">
          <span class="text-foreground">Affordable</span>
          <span class="text-muted">pricing plan</span>
        </h2>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service, index) => (
          <div
            class={`bg-background rounded-2xl shadow p-6 hover:shadow-md transition 
            ${index >= 4 ? "md:col-span-2" : "col-span-1"}`}
          >
            <div class="text-muted text-xl mb-16">+</div>
            <h3 class="font-semibold text-lg text-foreground mb-2">
              {service.title}
            </h3>
            <p class="text-muted text-sm leading-relaxed">
              {service.description}
            </p>
          </div>
        ))
      }
    </div>

