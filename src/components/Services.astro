---
const services = [
  {
    title: 'AI Development',
    description:
      'Our UI/UX Design service focuses on crafting intuitive, accessible, and visually appealing digital experiences that leave a lasting impression.',
  },
  {
    title: 'UI/UX Design',
    description:
      'Our UI/UX Design service focuses on crafting intuitive, accessible, and visually appealing digital experiences that leave a lasting impression.',
  },
  {
    title: 'Web Development',
    description:
      'Our UI/UX Design service focuses on crafting intuitive, accessible, and visually appealing digital experiences that leave a lasting impression.',
  },
  {
    title: 'E-commerce Development',
    description:
      'Our UI/UX Design service focuses on crafting intuitive, accessible, and visually appealing digital experiences that leave a lasting impression.',
  },
  {
    title: 'Branding',
    description:
      'Our UI/UX Design service focuses on crafting intuitive, accessible, and visually appealing digital experiences that leave a lasting impression.',
  },
  {
    title: 'No-code (Webflow, Framer)',
    description:
      'Our UI/UX Design service focuses on crafting intuitive, accessible, and visually appealing digital experiences that leave a lasting impression.',
  },
];
---

<section class="">
  <div class="">
    <!-- Heading -->
    <div class="mb-3 flex flex-col md:mb-6 md:flex-row md:gap-10">
      <p class="text-sm font-medium uppercase tracking-wider">
        <span class="mr-1 text-lg text-[#ff6a00]">✷</span>SERVICES
      </p>
      <h2 class="section-title max-w-3xl">
        Elevate your brand
        <span class="text-muted">with exceptional design solutions</span>
      </h2>
    </div>
    <!-- Services cards  -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service, index) => (
          <div
            class={`rounded bg-background p-6 shadow transition hover:shadow-md ${index >= 4 ? 'md:col-span-2' : 'col-span-1'}`}>
            <div class="mb-16 text-xl text-muted">+</div>
            <h3 class="mb-2 text-lg font-semibold text-foreground">
              {service.title}
            </h3>
            <p class="text-sm leading-relaxed text-muted">
              {service.description}
            </p>
          </div>
        ))
      }
    </div>
    <!-- View all services button  -->
    <div class="mx-auto mt-12 text-center">
      <a href="/services" class="btn btn-primary p-2 pl-4">
        View All Services
        <div
          class="ml-2 inline-flex items-center justify-center rounded bg-background p-1">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="none"
            viewBox="0 0 24 24"
            class="text-foreground">
            <path
              d="M7 17L17 7M9 7h8v8"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </a>
    </div>
  </div>
</section>
