---
// src/components/Services.astro
import Card from './Card.astro';
const services = [
  {
    link: 'example.com',
    icon: '',
    title: 'Website Design & Development',
    description:
      'Upload your design or website draft and get instant AI-powered analysis with accessibility recommendations.',
    features: [
      'Screen Reader Compatible',
      'Keyboard Navigation',
      'High Contrast Support',
    ],
    cta: [
      {
        icon: '',
        text: '100% accessibility compliant',
        link: 'example.com',
        variant: 'primary',
      },
    ],
  },
  {
    link: 'example.com',
    icon: '',
    title: 'Mobile App Design & Development',
    description:
      'Universal mobile apps designed for all users, including those with disabilities.',
    features: ['Voice Control', 'Large Touch Targets', 'Adaptive Interfaces'],
    cta: [
      {
        icon: '',
        text: 'Cross-platform accessibility',
        link: 'example.com',
        variant: 'primary',
      },
    ],
  },
  {
    link: 'example.com',
    icon: '',
    title: 'Accessibility Auditing',
    description:
      'Comprehensive accessibility audits and remediation services for existing digital products.',
    features: ['Automated Testing', 'Manual Review', 'Remediation Plans'],
    cta: [
      {
        icon: '',
        text: '100% accessibility compliant',
        link: 'example.com',
        variant: 'primary',
      },
    ],
  },
  {
    link: 'example.com',
    icon: '',
    title: 'AI-Powered Branding',
    description:
      'Intelligent branding solutions that consider accessibility and inclusivity from the start.',
    features: [
      'Color Blind Friendly',
      'Cultural Sensitivity',
      'Universal Symbols',
    ],
    cta: [
      {
        icon: '',
        text: 'Exclusive design principles',
        link: 'example.com',
        variant: 'primary',
      },
    ],
  },
  {
    link: 'example.com',
    icon: '',
    title: 'UI/UX Design',
    description:
      'User experiences designed for everyone, regardless of ability or technical expertise.',
    features: ['Clear Navigation', 'Consistent Layouts', 'Error Prevention'],
    cta: [
      {
        icon: '',
        text: 'Universal design approach',
        link: 'example.com',
        variant: 'primary',
      },
    ],
  },
  {
    link: 'example.com',
    icon: '',
    title: 'Creative Consulting',
    description:
      'Strategic guidance for creating inclusive digital experiences that reach all audiences.',
    features: ['WCAG Compliance', 'User Testing', 'Inclusive Research'],
    cta: [
      {
        icon: '',
        text: 'Accessibility expertise',
        link: 'example.com',
        variant: 'primary',
      },
    ],
  },
];
---

<section class="section">
  <header class="section-header">
    <h2 class="section-title text-gradient">Design for Everyone</h2>
    <p class="section-subtitle">AI-powered solutions that work for all users</p>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      services.map((service) => (
        <Card>
          <h4 slot="card-header" class="card-title mb-2">
            {service.title}
          </h4>

          <div slot="card-content">
            <p class="text-foreground">{service.description}</p>
            <div class="mt-4">
              <p class="font-semibold my-2 text-foreground">Key Features:</p>
              <ul class="list-disc pl-4 text-foreground">
                {service.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
            </div>
          </div>

          <div slot="card-footer" class="card-footer flex flex-col gap-2">
            {service.cta.map((action) => (
              <a
                href={action.link}
                class={`card-cta ${
                  action.variant === 'primary'
                    ? 'card-cta-primary'
                    : action.variant === 'secondary'
                      ? 'card-cta-secondary'
                      : action.variant === 'outline'
                        ? 'card-cta-outline'
                        : ''
                }`}>
                {action.text}
              </a>
            ))}
          </div>
        </Card>
      ))
    }
  </div>
</section>
