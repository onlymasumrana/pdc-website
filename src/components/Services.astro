    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service, index) => (
          <div
            class={`rounded-2xl bg-background p-6 shadow transition hover:shadow-md ${index >= 4 ? 'md:col-span-2' : 'col-span-1'}`}>
            <div class="mb-16 text-xl text-muted">+</div>
            <h3 class="mb-2 text-lg font-semibold text-foreground">
              {service.title}
            </h3>
            <p class="text-sm leading-relaxed text-muted">
              {service.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
