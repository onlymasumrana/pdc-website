---
const services = [
  {
    title: "AI Development",
    description:
      "Our UI/UX Design service focuses on crafting intuitive, accessible, and visually appealing digital experiences that leave a lasting impression.",
  },
  {
    title: "UI/UX Design",
    description:
      "Our UI/UX Design service focuses on crafting intuitive, accessible, and visually appealing digital experiences that leave a lasting impression.",
  },
  {
    title: "Web Development",
    description:
      "Our UI/UX Design service focuses on crafting intuitive, accessible, and visually appealing digital experiences that leave a lasting impression.",
  },
  {
    title: "E-commerce Development",
    description:
      "Our UI/UX Design service focuses on crafting intuitive, accessible, and visually appealing digital experiences that leave a lasting impression.",
  },
  {
    title: "Branding",
    description:
      "Our UI/UX Design service focuses on crafting intuitive, accessible, and visually appealing digital experiences that leave a lasting impression.",
  },
  {
    title: "No-code (Webflow, Framer)",
    description:
      "Our UI/UX Design service focuses on crafting intuitive, accessible, and visually appealing digital experiences that leave a lasting impression.",
  },
