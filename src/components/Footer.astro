---
// src/components/Footer.astro
import Logo from './Logo.astro';
---

<footer class="section">
  <div class="animated-block rounded mx-auto bg-background p-8 md:p-12 lg:p-16">
    <!-- Main Footer Content -->
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
      <!-- Brand Section -->
      <div class="space-y-6">
        <!-- Logo & Tagline -->
        <div class="space-y-4">
          <Logo class="h-8 w-auto text-foreground" />
          <p class="max-w-md text-lg leading-relaxed text-foreground-muted">
            A creative web design agency crafting user-centric solutions,
            blending aesthetics and functionality for an inclusive digital
            experience.
          </p>
        </div>

        <!-- Contact Information -->
        <div class="space-y-3">
          <div class="flex items-center gap-3">
            <svg
              class="h-5 w-5 min-h-5 min-w-5 text-primary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <a
              href="mailto:info.premiumdesigncompany@gmail.com"
              class="text-foreground-muted hover:underline transition-colors duration-200 hover:text-primary">
              info.premiumdesigncompany@gmail.com
            </a>
          </div>
          <div class="flex items-center gap-3">
            <svg
              class="h-5 w-5 min-h-5 min-w-5 text-primary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            <a
              href="tel:+33759440610"
              class="text-foreground-muted hover:underline transition-colors duration-200 hover:text-primary">
              +33 75 944 06 10
            </a>
          </div>
          <div class="flex items-center gap-3">
            <svg
              class="h-5 w-5 min-h-5 min-w-5 text-primary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1"
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
              ></path>
            </svg>
            <a
              href="https://wa.me/46769220990"
              target="_blank"
              rel="noopener noreferrer"
              class="text-foreground-muted hover:underline transition-colors duration-200 hover:text-primary">
              +46 76 922 09 90 (WhatsApp)
            </a>
          </div>
          <div class="flex items-center gap-3">
            <svg
              class="h-5 w-5 min-h-5 min-w-5 text-primary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span class="text-foreground-muted">Gothenburg, Sweden | Paris, France</span>
          </div>
        </div>
      </div>

      <div class="flex flex-col justify-between">
        <!-- Navigation Links -->
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
          <!-- Company -->
          <div>
            <h3 class="mb-4 text-lg font-semibold text-foreground">Company</h3>
            <ul class="space-y-3 text-base">
              <li>
                <a
                  href="/about"
                  class="text-foreground-muted transition-colors duration-200 hover:text-primary"
                  >About</a
                >
              </li>
              <li>
                <a
                  href="/blogs"
                  class="text-foreground-muted transition-colors duration-200 hover:text-primary"
                  >Blogs</a
                >
              </li>
              <li>
                <a
                  href="/careers"
                  class="text-foreground-muted transition-colors duration-200 hover:text-primary"
                  >Careers</a
                >
              </li>
            </ul>
          </div>

          <!-- Resources -->
          <div>
            <h3 class="mb-4 text-lg font-semibold text-foreground">
              Resources
            </h3>
            <ul class="space-y-3 text-base">
              <li>
                <a
                  href="/contact"
                  class="text-foreground-muted transition-colors duration-200 hover:text-primary"
                  >Contact</a
                >
              </li>
              <li>
                <a
                  href="/pricing"
                  class="text-foreground-muted transition-colors duration-200 hover:text-primary"
                  >Pricing</a
                >
              </li>
              <li>
                <a
                  href="/services"
                  class="text-foreground-muted transition-colors duration-200 hover:text-primary"
                  >Services</a
                >
              </li>
            </ul>
          </div>

          <!-- Legal -->
          <div>
            <h3 class="mb-4 text-lg font-semibold text-foreground">Legal</h3>
            <ul class="space-y-3 text-base">
              <li>
                <a
                  href="/privacy-policy"
                  class="text-foreground-muted transition-colors duration-200 hover:text-primary"
                  >Privacy Policy</a
                >
              </li>
              <li>
                <a
                  href="/terms-conditions"
                  class="text-foreground-muted transition-colors duration-200 hover:text-primary"
                  >Terms & Conditions</a
                >
              </li>
              <li>
                <a
                  href="/cookie-policy"
                  class="text-foreground-muted transition-colors duration-200 hover:text-primary"
                  >Cookie Policy</a
                >
              </li>
              <li>
                <a
                  href="/gdpr-compliance"
                  class="text-foreground-muted transition-colors duration-200 hover:text-primary"
                  >GDPR Compliance</a
                >
              </li>
            </ul>
          </div>
        </div>
        <!-- Social Links -->
        <div
          class="mt-8 flex flex-col justify-center gap-4 pr-4 md:flex-row md:items-center md:self-end md:justify-self-end">
          <p class="font-medium">Follow us:</p>
          <div class="flex items-center gap-4">
            <a
              href="https://x.com/pdcagency"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Follow us on X (Twitter)"
              class="hover:bg-primary/5 rounded border border-border-muted p-2 text-foreground-muted transition-all duration-200 hover:border-border hover:text-primary">
              <svg class="min-h-5 min-w-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H17.3l-5.468-7.135L5.6 21.75H2.292l7.73-8.838L1.8 2.25h6.1l4.935 6.483 5.41-6.483z"
                ></path>
              </svg>
            </a>
            <a
              href="https://www.linkedin.com/company/premiumdesigncompany"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Follow us on LinkedIn"
              class="hover:bg-primary/5 rounded border border-border-muted p-2 text-foreground-muted transition-all duration-200 hover:border-border hover:text-primary">
              <svg class="min-h-5 min-w-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M4.98 3.5C4.98 5 3.9 6 2.5 6S0 5 0 3.5C0 2 1.08 1 2.5 1s2.48 1 2.48 2.5zM.5 8h4V24h-4V8zm7 0h3.8v2.2h.1c.5-1 1.7-2.2 3.6-2.2 3.8 0 4.5 2.5 4.5 5.7V24h-4v-8.2c0-2 0-4.5-2.7-4.5-2.7 0-3.1 2.1-3.1 4.3V24h-4V8z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
    <!-- Bottom Section -->
    <div
      class="mt-8 border-t border-border-muted pt-8 text-center text-sm text-foreground-muted">
      <!-- Copyright -->
      <p>© 2025 Premium Design. All rights reserved.</p>
    </div>
  </div>
</footer>
