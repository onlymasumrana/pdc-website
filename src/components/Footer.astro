---
// src/components/Footer.astro
---

<footer class="section">
  <div
    class="max-w-7xl mx-auto px-6 py-12"
  >
    <div class="flex justify-between flex-col md:flex-row">
      <!-- Left Logo & Description -->
      <div class="flex-1">
        <h2 class="font-semibold text-lg text-foreground mb-3">
          Premium<br />Design.
        </h2>
        <p class="text-sm text-foreground-muted max-w-xs">
          A creative web design agency crafting user-centric solutions, blending
          aesthetics and functionality for an inclusive digital experience.
        </p>
      </div>
      <div class="flex flex-1 justify-between my-5">
        <!-- Company -->
        <div>
          <h3 class="font-semibold text-lg text-foreground mb-3">Company</h3>
          <ul class="space-y-2 text-sm text-foreground-muted">
            <li><a href="/about">About</a></li>
            <li><a href="/blog">Blog</a></li>
            <li>
              <a href="/customer">Customer</a>
            </li>
            <li><a href="/404">404</a></li>
            <li><a href="/careers">Careers</a></li>
          </ul>
        </div>

        <!-- Other -->
        <div>
          <h3 class="font-semibold text-lg text-foreground mb-3">Other</h3>
          <ul class="space-y-2 text-sm text-foreground-muted">
            <li>
              <a href="/changelog">Changelog</a>
            </li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/pricing">Pricing</a></li>
            <li><a href="/login">Login</a></li>
            <li><a href="/signup">Signup</a></li>
          </ul>
        </div>

        <!-- Legal -->
        <div>
          <h3 class="font-semibold text-lg text-foreground mb-3">Legal</h3>
          <ul class="space-y-2 text-sm text-foreground-muted">
            <li>
              <a href="/privacy">Privacy Policy</a>
            </li>
            <li>
              <a href="/terms">Terms & Conditions</a
              >
            </li>
          </ul>
        </div>
      </div>
    </div>
    <div class="flex justify-between flex-col md:flex-row my-5">
      <p>© 2025 Apricco by Premium Design</p>
       <div class="flex gap-3">
      <!-- X (Twitter) -->
      <a href="#" aria-label="Twitter" class="p-2 border rounded-xl hover:bg-gray-100">
        <svg class="w-5 h-5 text-gray-700" fill="currentColor" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H17.3l-5.468-7.135L5.6 21.75H2.292l7.73-8.838L1.8 2.25h6.1l4.935 6.483 5.41-6.483z"/>
        </svg>
      </a>
      <!-- LinkedIn -->
      <a href="#" aria-label="LinkedIn" class="p-2 border rounded-xl hover:bg-gray-100">
        <svg class="w-5 h-5 text-gray-700" fill="currentColor" viewBox="0 0 24 24">
          <path d="M4.98 3.5C4.98 5 3.9 6 2.5 6S0 5 0 3.5C0 2 1.08 1 2.5 1s2.48 1 2.48 2.5zM.5 8h4V24h-4V8zm7 0h3.8v2.2h.1c.5-1 1.7-2.2 3.6-2.2 3.8 0 4.5 2.5 4.5 5.7V24h-4v-8.2c0-2 0-4.5-2.7-4.5-2.7 0-3.1 2.1-3.1 4.3V24h-4V8z"/>
        </svg>
      </a>
      <!-- Facebook -->
      <a href="#" aria-label="Facebook" class="p-2 border rounded-xl hover:bg-gray-100">
        <svg class="w-5 h-5 text-gray-700" fill="currentColor" viewBox="0 0 24 24">
          <path d="M22 12a10 10 0 1 0-11.5 9.9v-7h-2v-3h2v-2c0-2 1.2-3 3-3h2v3h-1c-1 0-1 .5-1 1v1h2.5l-.5 3H14v7A10 10 0 0 0 22 12"/>
        </svg>
      </a>
    </div>
    </div>
  </div>
</footer>
