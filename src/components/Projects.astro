---
const cards = [
  {
    img: '/assets/token-alert.png',
    category: 'Design',
    title: 'Token Alert',
    link: 'https://www.coroflot.com/MasumRana/Token-Alert',
  },
  {
    img: '/assets/ico-invest.png',
    category: 'Design',
    title: 'ICO Invest',
    link: 'https://www.coroflot.com/MasumRana/ICO-Invest',
  },
  {
    img: '/assets/us-trade.png',
    category: 'Conceptual',
    title: 'US Trade',
    link: 'https://www.coroflot.com/MasumRana/US-Trade',
  },
  {
    img: '/assets/supplyr.png',
    category: 'Dashboard',
    title: 'Supplyr',
    link: 'https://www.coroflot.com/MasumRana/Supplyr',
  },
  {
    img: '/assets/meena.png',
    category: 'Landing Page',
    title: 'Meena App for Children',
    link: 'https://www.coroflot.com/MasumRana/Meena-App-for-Children',
  },
  {
    img: '/assets/directory-listing.jpg',
    category: 'Website',
    title: 'Directory Listing',
    link: 'https://www.coroflot.com/MasumRana/Directory-Listing',
  },
];
---

<section class="">
  <!-- Heading -->
  <div class="mb-3 flex flex-col md:mb-6 md:flex-row md:gap-10">
    <p class="text-sm font-medium uppercase tracking-wider">
      <span class="mr-1 text-xl text-[#ff6a00]">✷</span>PORTFOLIO
    </p>
    <h2 class="section-title flex flex-wrap gap-2">
      <span class="text-muted">Remarkable</span>
      projects
    </h2>
  </div>
  <div>
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        cards.map((card) => (
          <a
            href={card.link}
            target="_blank"
            class="animated-block overflow-hidden rounded bg-background shadow">
            <img
              src={card.img}
              alt={card.title}
              class="aspect-video w-full object-cover"
            />
            <div class="p-6 pt-4">
              <p class="text-sm text-foreground-muted">{card.category}</p>
              <h3 class="mt-1 text-lg font-semibold capitalize">{card.title}</h3>
            </div>
          </a>
        ))
      }
    </div>
    <div class="mx-auto hidden mt-12 text-center">
      <a
        href="https://dribbble.com/premiumdesigncompany"
        target="_blank"
        class="btn btn-primary p-2 pl-4">
        View All Projects
        <div
          class="ml-2 inline-flex items-center justify-center rounded bg-background p-1">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            fill="none"
            viewBox="0 0 24 24"
            class="text-foreground">
            <path
              d="M7 17L17 7M9 7h8v8"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </a>
    </div>
  </div>
</section>
