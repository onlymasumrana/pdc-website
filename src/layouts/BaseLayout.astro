---
// src/layouts/BaseLayout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Define available themes in a single source of truth
const availableThemes = [
  { value: '', label: 'Neutral Light' },
  { value: 'neutral-dark', label: 'Neutral Dark' },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="description" content="Premium Design Company" />
    <meta
      name="keywords"
      content="UI/UX Design, Product Design, Web Design, SaaS Design, Landing Page Design, Website Redesign, UX Research, Figma Expert, Webflow Designer, Framer, Design Systems, Dashboard Design, Mobile App UI, Wireframes, High-Fidelity Mockups, Interaction Design, User Flow, UX Strategy, Responsive Web Design, Conversion Optimization, Branding & Visual Identity Masum Rana, Masum Rana Upwork, Masusm Rana Designer, Masum Rana UI Designer, Masum Rana Premium Design Company, Premium Design Company Upwork, Premium Design Company Figma, Premium Design Company Portfolio, Masum rana ui designer, Masum rana web designer, Masum rana product designer, Masum rana website designer, masum rana premium design company, masum rana ux designer, masum rana ui/ux, masum rana ui/ux designer, afiur rahman fahim, afiur rahman fahiim upwork, afiur rahman fahiim developer, afiur rahman fahiim ui developer, afiur rahman fahiim premium design company, afiur rahman fahiim ui/ux, afiur rahman fahiim ui/ux developer, afiur rahman fahiim web developer, afiur rahman fahiim frontend developer, afiur rahman fahiim web developer, afiur rahman fahiim website developer, afiur rahman fahiim web product developer, faahim, afiur rahman faahim, afiur rahman faahim react developer, afiur rahman faahim nextjs developer, afiur rahman faahim astro developer, afiur rahman faahim astro js developer, afiur rahman faahim astro js, afiur rahman faahim astro, afiur rahman faahim premium design company, afiur rahman faahim ui/ux developer, afiur rahman faahim ui/ux, afiur rahman faahim web developer, afiur rahman faahim frontend developer, afiur rahman faahim website developer, afiur rahman faahim web product developer, premium design company, premium design company upwork, premium design company figma, premium design company portfolio"
    />
    <meta name="author" content="Premium Design Company" />
    <meta name="generator" content={Astro.generator} />
    <title>Premium Design Company</title>
    <script is:inline>
      const getInitialTheme = () => {
        const saved = localStorage.getItem('theme');
        if (saved === 'neutral-dark') return 'neutral-dark';
        if (saved === 'light') return ''; // Explicit light theme override
        
        // Auto 1: Check system color scheme preference
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (systemPrefersDark) return 'neutral-dark';

        // Auto 2: Check current hour (Dark theme active between 6:00 PM and 6:00 AM)
        const hour = new Date().getHours();
        const isNight = hour >= 18 || hour < 6;
        if (isNight) return 'neutral-dark';

        return '';
      };

      const theme = getInitialTheme();
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>

  <!-- bg-background-muted bg-[radial-gradient(circle,var(--color-border-muted)_.25px,transparent_2.5px)]  [background-size:32px_32px]
  is the dotted background pattern  -->
  <body
    class="mx-auto flex min-h-screen max-w-[1440px] flex-col bg-background-muted bg-[radial-gradient(circle,var(--color-border-muted)_.25px,transparent_2.5px)] p-4 text-foreground [background-size:32px_32px] sm:px-6 lg:px-8">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- Floating Theme Toggle -->
    <button
      id="theme-toggle"
      class="fixed bottom-6 right-6 z-50 flex items-center justify-center rounded-full border border-border-muted bg-card-bg p-3 shadow-lg backdrop-blur-sm text-foreground transition-all duration-200 hover:bg-background-muted hover:border-border hover:text-primary"
      aria-label="Toggle Theme">
      <!-- Sun Icon (hidden by default, shown in dark mode) -->
      <svg
        id="theme-toggle-light-icon"
        class="hidden h-5 w-5"
        fill="currentColor"
        viewBox="0 0 20 20">
        <path
          d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.46 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z"
          fill-rule="evenodd"
          clip-rule="evenodd"></path>
      </svg>
      <!-- Moon Icon (shown by default, hidden in dark mode) -->
      <svg
        id="theme-toggle-dark-icon"
        class="h-5 w-5"
        fill="currentColor"
        viewBox="0 0 20 20">
        <path
          d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
      </svg>
    </button>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const themeToggle = document.getElementById('theme-toggle');
        const lightIcon = document.getElementById('theme-toggle-light-icon');
        const darkIcon = document.getElementById('theme-toggle-dark-icon');

        const updateIcons = (theme) => {
          if (theme === 'neutral-dark') {
            lightIcon?.classList.remove('hidden');
            darkIcon?.classList.add('hidden');
          } else {
            lightIcon?.classList.add('hidden');
            darkIcon?.classList.remove('hidden');
          }
        };

        // Initialize icons based on current theme set in <head>
        const currentTheme = document.documentElement.getAttribute('data-theme') || '';
        updateIcons(currentTheme);

        themeToggle?.addEventListener('click', () => {
          const isDark = document.documentElement.getAttribute('data-theme') === 'neutral-dark';
          // Save 'light' explicitly to distinguish it from 'no manual override'
          const newTheme = isDark ? 'light' : 'neutral-dark';
          
          document.documentElement.setAttribute('data-theme', newTheme === 'light' ? '' : 'neutral-dark');
          localStorage.setItem('theme', newTheme);
          updateIcons(newTheme === 'light' ? '' : 'neutral-dark');
        });

        // Listen for live system theme changes (e.g. system switches theme while page is open)
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
          if (!localStorage.getItem('theme')) {
            const newTheme = e.matches ? 'neutral-dark' : '';
            document.documentElement.setAttribute('data-theme', newTheme);
            updateIcons(newTheme);
          }
        });

        // === Premium Page Entry & Scroll Animations ===
        // 1. Trigger Hero Page Entry Animation on Load
        setTimeout(() => {
          document.body.classList.add('loaded');
        }, 100);

        // 2. Automate Reveal Classes and Stagger Delays
        const sections = document.querySelectorAll('main > section, main > div > section, footer');
        sections.forEach((el, index) => {
          // If first section (Hero / Header), slide in on load. Others on scroll.
          if (index === 0) {
            el.classList.add('reveal-on-load');
          } else {
            el.classList.add('reveal-on-scroll');
          }
        });

        // Automatically add stagger delay to card grids
        const grids = document.querySelectorAll('.grid');
        grids.forEach((grid) => {
          const children = grid.children;
          Array.from(children).forEach((child, childIndex) => {
            child.style.transitionDelay = `${childIndex * 75}ms`;
          });
        });

        // 3. Intersection Observer for Scroll Reveals
        const observerOptions = {
          root: null,
          rootMargin: '0px 0px -8% 0px', // trigger slightly before entering viewport
          threshold: 0.05,
        };

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              obs.unobserve(entry.target); // Stop observing once animated
            }
          });
        }, observerOptions);

        document.querySelectorAll('.reveal-on-scroll').forEach((el) => {
          observer.observe(el);
        });
      });
    </script>
  </body>
</html>
