---
// src/layouts/BaseLayout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en" data-theme="">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon-2.png" /> -->
    <meta name="description" content="Premium Design Company" />
    <meta
      name="keywords"
      content="UI/UX Design, Product Design, Web Design, SaaS Design, Landing Page Design, Website Redesign, UX Research, Figma Expert, Webflow Designer, Framer, Design Systems, Dashboard Design, Mobile App UI, Wireframes, High-Fidelity Mockups, Interaction Design, User Flow, UX Strategy, Responsive Web Design, Conversion Optimization, Branding & Visual Identity"
    />
    <meta name="author" content="Premium Design Company" />
    <meta name="generator" content={Astro.generator} />
    <title>Premium Design Company</title>
  </head>
  <body class="bg-background text-foreground">
    <Header />
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      <slot />
    </main>
    <Footer />

    <!-- theme switcher -->
    <div
      class="fixed bottom-4 right-4 z-50 p-2 bg-background border border-border rounded-md shadow-sm">
      <label for="themeSelect" class="block text-xs font-medium mb-1"
        >Theme:</label
      >
      <select
        id="themeSelect"
        class="text-sm px-2 py-1 rounded border border-border bg-background text-foreground"
        onchange="document.documentElement.setAttribute('data-theme', this.value); localStorage.setItem('theme', this.value);">
        <option value="cyberpunk">Cyberpunk</option>
        <option value="terminal-light">Terminal Light</option>
        <option value="terminal-dark">Terminal-Dark</option>
        <option value="node-light">Node Light</option>

        <option value="vue-light">Vue Light</option>
        <option value=""></option>
      </select>
    </div>

    <script>
      // Set initial theme
      const savedTheme = localStorage.getItem('theme') || 'vue-light';
      document.documentElement.setAttribute('data-theme', savedTheme);

      // Safely set the select value with proper type casting
      const themeSelect = document.getElementById('themeSelect');
      if (themeSelect && themeSelect instanceof HTMLSelectElement) {
        themeSelect.value = savedTheme;
      }
    </script>
  </body>
</html>
