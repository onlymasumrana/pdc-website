---
// src/layouts/BaseLayout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Premium Design Company - Accessible, Inclusive, AI-Powered." />
    <meta name="keywords" content="design, accessibility, AI, inclusive design, web design, mobile app design" />
    <meta name="author" content="Premium Design Company" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <title>Premium Design Company</title>
  </head>
  <body class="bg-bg text-text">
    <Header />
    <main class="flex flex-col">
      <slot />
    </main>
    <Footer />
  </body>
</html>
