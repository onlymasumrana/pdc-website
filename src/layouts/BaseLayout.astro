---
// src/layouts/BaseLayout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Define available themes in a single source of truth
const availableThemes = [
  { value: '', label: 'Default' },
  { value: 'cyberpunk', label: 'Cyberpunk' },
  { value: 'vue-light', label: 'Vue Light' },
  { value: 'terminal-dark', label: 'Terminal Dark' },
  
];
// Get initial theme
const initialTheme = 'vue-light';
---

<html lang="en" data-theme={initialTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="description" content="Premium Design Company" />
    <meta
      name="keywords"
      content="UI/UX Design, Product Design, Web Design, SaaS Design, Landing Page Design, Website Redesign, UX Research, Figma Expert, Webflow Designer, Framer, Design Systems, Dashboard Design, Mobile App UI, Wireframes, High-Fidelity Mockups, Interaction Design, User Flow, UX Strategy, Responsive Web Design, Conversion Optimization, Branding & Visual Identity"
    />
    <meta name="author" content="Premium Design Company" />
    <meta name="generator" content={Astro.generator} />
    <title>Premium Design Company</title>
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground">
    <Header />
    <main class="flex-grow container-custom py-8">
      <slot />
    </main>
    <Footer />

    <!-- Theme Switcher -->
    <div
      class="fixed bottom-4 right-4 z-50 p-3 bg-card-bg border border-border rounded-lg shadow-lg backdrop-blur-sm glass">
      <label
        for="themeSelect"
        class="block text-xs font-medium text-foreground-muted mb-1 sr-only">
        Select Theme:
      </label>
      <select
        id="themeSelect"
        class="w-full text-sm px-3 py-2 rounded-md border border-border bg-form-input-bg text-form-input-text focus:outline-none focus:ring-2 focus:ring-focus-ring cursor-pointer"
        onchange="handleThemeChange(this.value)">
        {
          availableThemes.map((theme) => (
            <option value={theme.value}>{theme.label}</option>
          ))
        }
      </select>
    </div>

    <script is:inline>
      // Single source of truth for themes (must match the Astro array defined above)
      const themes = [
        { value: '', label: 'Close to Tanvir Vai\'s design' },
        { value: 'cyberpunk', label: 'Cyberpunk' },
        { value: 'vue-light', label: 'Vue Light' },
        { value: 'terminal-dark', label: 'Terminal Dark' },
      ];

      // Set initial theme from localStorage or default
      const getSavedTheme = () => {
        const saved = localStorage.getItem('theme');
        // Validate the saved theme exists in our list
        return themes.some((t) => t.value === saved) ? saved : 'vue-light';
      };

      const initialTheme = getSavedTheme();
      document.documentElement.setAttribute('data-theme', initialTheme);

      // Update the select element
      const themeSelect = document.getElementById('themeSelect');
      if (themeSelect) {
        themeSelect.value = initialTheme;
      }

      // Handler for theme change
      function handleThemeChange(themeValue) {
        document.documentElement.setAttribute('data-theme', themeValue);
        localStorage.setItem('theme', themeValue);
      }
    </script>
  </body>
</html>
