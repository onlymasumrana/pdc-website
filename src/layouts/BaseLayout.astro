---
// src/layouts/BaseLayout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Premium Design Company" />
    <meta
      name="keywords"
      content="UI/UX Design, Product Design, Web Design, SaaS Design, Landing Page Design, Website Redesign, UX Research, Figma Expert, Webflow Designer, Framer, Design Systems, Dashboard Design, Mobile App UI, Wireframes, High-Fidelity Mockups, Interaction Design, User Flow, UX Strategy, Responsive Web Design, Conversion Optimization, Branding & Visual Identity"
    />
    <meta name="author" content="Premium Design Company" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <title>Premium Design Company</title>
  </head>
  <body class="bg-background text-foreground">
    <Header />
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
